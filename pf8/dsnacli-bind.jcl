//DB2BINDJ JOB (ACCT),'BIND DSNACLI',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M,LINES=500000
//*
//* PLAN DSNACLI FUER DB2 ODBC (WIE INSTALLATIONSJOB DSNTIJCL).
//* NUR NOETIG, WENN DER PLAN FEHLT; SONST GENUEGT
//*   GRANT EXECUTE ON PLAN DSNACLI TO <USER>
//* PLATZHALTER: DSN (DB2-HLQ), DB2A (SUBSYSTEM). COLLECTION UND
//* PACKAGE-LISTE MIT DSNTIJCL DER EIGENEN DB2-VERSION VERGLEICHEN.
//* AUF Z/OS NOCH NICHT GETESTET.
//*
//BIND     EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=DSN.SDSNEXIT
//         DD DISP=SHR,DSN=DSN.SDSNLOAD
//DBRMLIB  DD DISP=SHR,DSN=DSN.SDSNDBRM
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSTSIN  DD *
 DSN SYSTEM(DB2A)
 BIND PACKAGE (DSNAOCLI) MEMBER(DSNCLICS) ISOLATION(CS) -
      ACTION(REPLACE) ENCODING(EBCDIC)
 BIND PACKAGE (DSNAOCLI) MEMBER(DSNCLIRR) ISOLATION(RR) -
      ACTION(REPLACE) ENCODING(EBCDIC)
 BIND PACKAGE (DSNAOCLI) MEMBER(DSNCLIRS) ISOLATION(RS) -
      ACTION(REPLACE) ENCODING(EBCDIC)
 BIND PACKAGE (DSNAOCLI) MEMBER(DSNCLIUR) ISOLATION(UR) -
      ACTION(REPLACE) ENCODING(EBCDIC)
 BIND PACKAGE (DSNAOCLI) MEMBER(DSNCLIC1) ACTION(REPLACE)
 BIND PACKAGE (DSNAOCLI) MEMBER(DSNCLIC2) ACTION(REPLACE)
 BIND PACKAGE (DSNAOCLI) MEMBER(DSNCLIF4) ACTION(REPLACE)
 BIND PACKAGE (DSNAOCLI) MEMBER(DSNCLIMS) ACTION(REPLACE)
 BIND PACKAGE (DSNAOCLI) MEMBER(DSNCLIQR) ACTION(REPLACE)
 BIND PLAN(DSNACLI) PKLIST(*.DSNAOCLI.*) ACTION(REPLACE)
 END
/*
