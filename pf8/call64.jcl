//CALL64J  JOB (ACCT),'COBOL->PASCAL',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M,LINES=500000
//*
//* PF8: COBOL (AMODE 31) RUFT PASCAL (AMODE 64) UEBER CEL4RO64
//* ZPCOB2 + ZP64CALL AUS HLQ.ZPAS.LOAD31 (PF8/BUILD31.SH),
//* PASCAL-DLL /U/USER/ZPAS/LIBCALL64LIB.SO (ZFPC CALL64LIB.PAS).
//* PLATZHALTER HLQ, PFAD ANPASSEN. ERWARTET: RC 0, ZWEI OK-ZEILEN.
//* AUF Z/OS NOCH NICHT GETESTET; BRAUCHT Z/OS 3.1 ODER LE MIT
//* DER APAR FUER CEL4RO64 (SONST ERGEBNIS -1006).
//*
//RUN      EXEC PGM=ZPCOB2
//STEPLIB  DD DISP=SHR,DSN=HLQ.ZPAS.LOAD31
//SYSIN    DD *
/u/user/ZPAS/libcall64lib.so
/*
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
