//DB2TESTJ JOB (ACCT),'PASCAL DB2',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M,LINES=500000
//*
//* PF8: PASCAL-PROGRAMM DB2TEST IM BATCH
//* (ZOS_PDS=DB2TEST ZFPC --DB2 DB2TEST.PAS)
//* PLATZHALTER: HLQ.ZPAS.LOAD (ZOS_PASLIB), DSN (DB2-HLQ),
//* DB2A (SUBSYSTEM), HLQ.ZPAS.DSNAOINI (WIE PF8/DSNAOINI.TXT,
//* RECFM=FB,LRECL=80). AUF Z/OS NOCH NICHT GETESTET.
//*
//RUN      EXEC PGM=DB2TEST,PARM='/DB2A'
//STEPLIB  DD DISP=SHR,DSN=HLQ.ZPAS.LOAD
//         DD DISP=SHR,DSN=DSN.SDSNEXIT
//         DD DISP=SHR,DSN=DSN.SDSNLOAD
//         DD DISP=SHR,DSN=DSN.SDSNLOD2
//DSNAOINI DD DISP=SHR,DSN=HLQ.ZPAS.DSNAOINI
//CEEOPTS  DD *
POSIX(ON)
/*
//SYSPRINT DD SYSOUT=*
//STDERR   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
