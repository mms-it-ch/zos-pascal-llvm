{ Erzeugt von pf1/probe/zosprobe.c auf z/OS - nicht von Hand ändern }

{ --- Typen --- }
type
  dev_t = cuint;
  ino_t = cuint;
  mode_t = cint;
  nlink_t = cint;
  uid_t = cint;
  gid_t = cint;
  off_t = clong;
  pid_t = cint;
  size_t = culong;
  ssize_t = clong;
  time_t = clong;
  clock_t = cuint;
  suseconds_t = cint;
  blksize_t = cint;
  blkcnt_t = clong;
  socklen_t = cuint;
  wchar_t = cuint;
  wint_t = cint;
  rlim_t = culong;
  clockid_t = cuint;
  key_t = cint;
  id_t = cint;

  sigset_t = record _data: array[0..7] of byte; end; { C: 8 Bytes, Ausrichtung 4 }
  pthread_t = record _data: array[0..7] of byte; end; { C: 8 Bytes, Ausrichtung 1 }
  pthread_attr_t = record _data: array[0..103] of byte; end; { C: 104 Bytes, Ausrichtung 8 }
  pthread_mutex_t = record _data: array[0..7] of byte; end; { C: 8 Bytes, Ausrichtung 8 }
  pthread_mutexattr_t = record _data: array[0..7] of byte; end; { C: 8 Bytes, Ausrichtung 1 }
  pthread_cond_t = record _data: array[0..7] of byte; end; { C: 8 Bytes, Ausrichtung 1 }
  pthread_condattr_t = record _data: array[0..7] of byte; end; { C: 8 Bytes, Ausrichtung 1 }
  pthread_key_t = record _data: array[0..7] of byte; end; { C: 8 Bytes, Ausrichtung 1 }
  pthread_once_t = record _data: array[0..3] of byte; end; { C: 4 Bytes, Ausrichtung 4 }
  pthread_rwlock_t = record _data: array[0..7] of byte; end; { C: 8 Bytes, Ausrichtung 1 }
  fd_set = record _data: array[0..255] of byte; end; { C: 256 Bytes, Ausrichtung 4 }
  c_jmp_buf = record _data: array[0..1023] of byte; end; { C: 1024 Bytes, Ausrichtung 8 }
  mbstate_t = record _data: array[0..1] of byte; end; { C: 2 Bytes, Ausrichtung 2 }

{ --- Strukturen --- }
type
  stat = record { C: 216 Bytes }
    st_eye: array[0..3] of AnsiChar;
    st_length: cushort;
    st_version: cushort;
    st_mode: cint;
    st_ino: cuint;
    st_dev: cuint;
    st_nlink: cint;
    st_uid: cint;
    st_gid: cint;
    st_size: clong;
    _pad0: array[0..11] of byte;
    st_rdev: cuint;
    _pad1: array[0..7] of byte;
    st_blksize: cint;
    _pad2: array[0..35] of byte;
    st_blocks: clong;
    _pad3: array[0..39] of byte;
    st_atime: clong;
    st_mtime: clong;
    st_ctime: clong;
    _pad4: array[0..39] of byte;
  end;

  dirent = record { C: 272 Bytes }
    _pad0: array[0..3] of byte;
    d_ino: cuint;
    _pad1: array[0..7] of byte;
    d_name: array[0..255] of AnsiChar;
  end;

  timeval = record { C: 16 Bytes }
    tv_sec: clong;
    _pad0: array[0..3] of byte;
    tv_usec: cint;
  end;

  timespec = record { C: 16 Bytes }
    tv_sec: clong;
    tv_nsec: clong;
  end;

  timezone = record { C: 8 Bytes }
    tz_minuteswest: cint;
    tz_dsttime: cint;
  end;

  tms = record { C: 16 Bytes }
    tms_utime: cuint;
    tms_stime: cuint;
    tms_cutime: cuint;
    tms_cstime: cuint;
  end;

  tm = record { C: 36 Bytes }
    tm_sec: cint;
    tm_min: cint;
    tm_hour: cint;
    tm_mday: cint;
    tm_mon: cint;
    tm_year: cint;
    tm_wday: cint;
    tm_yday: cint;
    tm_isdst: cint;
  end;

  utsname = record { C: 80 Bytes }
    sysname: array[0..15] of AnsiChar;
    nodename: array[0..31] of AnsiChar;
    release: array[0..7] of AnsiChar;
    version: array[0..7] of AnsiChar;
    machine: array[0..15] of AnsiChar;
  end;

  utimbuf = record { C: 16 Bytes }
    actime: clong;
    modtime: clong;
  end;

  flock = record { C: 24 Bytes }
    l_type: cshort;
    l_whence: cshort;
    l_start: clong;
    l_len: clong;
    l_pid: cint;
  end;

  rlimit = record { C: 16 Bytes }
    rlim_cur: culong;
    rlim_max: culong;
  end;

  iovec = record { C: 16 Bytes }
    iov_base: pointer;
    iov_len: culong;
  end;

  pollfd = record { C: 8 Bytes }
    fd: cint;
    events: cshort;
    revents: cshort;
  end;

  sigactionrec = record { C: 32 Bytes }
    sa_handler: pointer;
    sa_mask: array[0..7] of byte;
    sa_flags: cint;
    _pad0: array[0..11] of byte;
  end;

  siginfo_t = record { C: 64 Bytes }
    si_signo: cint;
    si_errno: cint;
    si_code: cint;
    _pad0: array[0..27] of byte;
    si_addr: pointer;
    _pad1: array[0..15] of byte;
  end;

  termios = record { C: 28 Bytes }
    c_cflag: cuint;
    c_iflag: cuint;
    c_lflag: cuint;
    c_oflag: cuint;
    c_cc: array[0..10] of byte;
    _pad0: array[0..0] of byte;
  end;

  statvfs = record { C: 128 Bytes }
    _pad0: array[0..7] of byte;
    bsize: culong;
    blocks: culong;
    _pad1: array[0..7] of byte;
    bavail: culong;
    flag: culong;
    _pad2: array[0..23] of byte;
    frsize: culong;
    bfree: culong;
    files: cuint;
    ffree: cuint;
    favail: cuint;
    _pad3: array[0..11] of byte;
    fsid: culong;
    namemax: culong;
  end;

{ --- Konstanten --- }
