     function llvm_ret_inreg(def: tabstractprocdef): boolean;
+      var
+        retloc: tcgpara;
       begin
         result:=(target_info.system=system_s390x_zos) and
           (def.returndef.typ=recorddef) and
           (def.proccalloption in cdecl_pocalls) and
           not paramanager.ret_in_param(def.returndef,def);
+        { records returned in GPRs only; complex-like records are returned
+          in FPRs as a plain struct (like clang) }
+        if result then
+          begin
+            retloc:=paramanager.get_funcretloc(def,callerside,nil);
+            result:=retloc.location^.loc=LOC_REGISTER;
+            retloc.reset;
+          end;
       end;
 
 
