diff --git a/rtl/s390x/setjump.inc b/rtl/s390x/setjump.inc
new file mode 100644
index 00000000..ce738029
--- /dev/null
+++ b/rtl/s390x/setjump.inc
@@ -0,0 +1,30 @@
+{
+    This file is part of the Free Pascal run time library.
+    Copyright (c) 2026 by the Free Pascal development team.
+
+    SetJmp/Longjmp for s390x
+
+    Exceptions use the LLVM (landing pad) model on s390x, so these compiler
+    helpers are never called. A setjmp cannot be implemented in Pascal
+    without assembler (the helper would return before the longjmp).
+
+    See the file COPYING.FPC, included in this distribution,
+    for details about the copyright.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+
+ **********************************************************************}
+
+function fpc_setjmp(var S : jmp_buf) : longint;[Public, alias : 'FPC_SETJMP'];compilerproc;
+  begin
+    result:=0;
+  end;
+
+
+procedure fpc_longjmp(var S : jmp_buf;value : longint);[Public, alias : 'FPC_LONGJMP'];compilerproc;
+  begin
+    { not supported on s390x }
+    halt(217);
+  end;
diff --git a/rtl/s390x/setjumph.inc b/rtl/s390x/setjumph.inc
new file mode 100644
index 00000000..74753a82
--- /dev/null
+++ b/rtl/s390x/setjumph.inc
@@ -0,0 +1,24 @@
+{
+    This file is part of the Free Pascal run time library.
+    Copyright (c) 2026 by the Free Pascal development team.
+
+    SetJmp/Longjmp declarations for s390x
+
+    Exceptions use the LLVM (landing pad) model on s390x, so FPC's own
+    setjmp/longjmp is not used. The type is required by the compiler and
+    has the size of the C jmp_buf on z/OS.
+
+    See the file COPYING.FPC, included in this distribution,
+    for details about the copyright.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+
+ **********************************************************************}
+
+type
+  jmp_buf = record
+    data: array[0..127] of qword;
+  end;
+  pjmp_buf = ^jmp_buf;
