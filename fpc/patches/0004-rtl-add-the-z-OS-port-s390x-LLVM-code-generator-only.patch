+
+{$I ctypes.inc}
+{$packrecords c}
+
+Type
+    dev_t    = cuint;
+    TDev     = dev_t;
+    pDev     = ^dev_t;
+
+    gid_t    = cint;
+    TGid     = gid_t;
+    pGid     = ^gid_t;
+    TIOCtlRequest = cInt;
+
+    ino_t    = cuint;
+    TIno     = ino_t;
+    pIno     = ^ino_t;
+    ino64_t  = cuint64;
+
+    mode_t   = cint;
+    TMode    = mode_t;
+    pMode    = ^mode_t;
+
+    nlink_t  = cint;
+    TnLink   = nlink_t;
+    pnLink   = ^nlink_t;
+
+    off_t    = clong;
+    TOff     = off_t;
+    pOff     = ^off_t;
+
+    pid_t    = cint;
+    TPid     = pid_t;
+    pPid     = ^pid_t;
+
+    size_t   = culong;
+    ssize_t  = clong;
+    clock_t  = cuint;
+    time_t   = clong;
+
+    wint_t    = cint;
+    TSize     = size_t;
+    pSize     = ^size_t;
+    psize_t   = pSize;
+    TSSize    = ssize_t;
+    pSSize    = ^ssize_t;
+    TClock    = clock_t;
+    pClock    = ^clock_t;
+    // TTime    = time_t;    // Not allowed in system unit, -> unixtype
+    pTime     = ^time_t;
+    ptime_t   = ^time_t;
+
+    clockid_t = cuint;
+    caddr_t   = ^AnsiChar;
+
+    uint32_t = cuint32;
+    int32_t = cint32;
+    uint16_t = cuint16;
+    uint_t    = cuint;
+    uintptr_t = ^cuint;
+
+    wchar_t   = cuint;
+    pwchar_t  = ^wchar_t;
+
+    uid_t    = cint;
+    TUid     = uid_t;
+    pUid     = ^uid_t;
+
+    socklen_t= cuint;
+    TSockLen = socklen_t;
+    pSockLen = ^socklen_t;
+
+    suseconds_t = cint;
+    blksize_t = cint;
+    blkcnt_t = clong;
+    key_t = cint;
+    id_t = cint;
+
+  { z/OS: tv_usec follows 4 padding bytes }
+  timeval     = record
+                 tv_sec  : time_t;
+                 __pad   : cint;
+                 tv_usec : suseconds_t;
+                end;
+  ptimeval    = ^timeval;
+  TTimeVal    = timeval;
+
+  timespec    = record
+                 tv_sec   : time_t;
+                 tv_nsec  : clong;
+                end;
+  ptimespec   = ^timespec;
+  TTimeSpec   = timespec;
+
+  fsblkcnt_t = culong;
+
+  TStatfs = record
+    dummy: array[0..255] of byte;
+  end;
+  PStatFS=^TStatFS;
+
+  mbstate_t = record
+    _data: array[0..1] of byte;
+  end;
+  pmbstate_t = ^mbstate_t;
+
+const
+    ARG_MAX        = 262144;   { Maximum number of argument size (not a constant on z/OS) }
+    NAME_MAX       = 255;      { Maximum number of bytes in filename }
+    PATH_MAX       = 1023;     { Maximum number of bytes in pathname (1024 incl. #0) }
+    SYS_NMLN       = 32;
+    SIG_MAXSIG     = 63;       { highest signal number }
+
+    Prio_Process = 1;
+    Prio_PGrp    = 2;
+    Prio_User    = 3;
+
+ type
+    { the pthread types are opaque structures on z/OS }
+    pthread_t = record
+      __: array[0..7] of byte;
+    end;
+    pthread_attr_t = record
+      __: array[0..12] of qword;
+    end;
+    pthread_mutexattr_t = record
+      __: array[0..7] of byte;
+    end;
+    pthread_cond_t = record
+      __: array[0..7] of byte;
+    end;
+    pthread_condattr_t = record
+      __: array[0..7] of byte;
+    end;
+    pthread_key_t = record
+      __: array[0..7] of byte;
+    end;
+    pthread_mutex_t = record
+      __: qword;
+    end;
+    pthread_rwlock_t = record
+      __: array[0..7] of byte;
+    end;
+    pthread_once_t = record
+      __: cint;
+    end;
+
+    sem_t = cint;
