diff --git a/rtl/zos/sighnd.inc b/rtl/zos/sighnd.inc
new file mode 100644
index 00000000..72890935
--- /dev/null
+++ b/rtl/zos/sighnd.inc
@@ -0,0 +1,39 @@
+{
+    This file is part of the Free Pascal run time library.
+    Copyright (c) 2026 by the Free Pascal development team
+
+    Signal handler for z/OS: converts synchronous signals into run-time
+    errors. Resuming at HandleErrorAddrFrame through the machine context
+    (as on other targets) is not implemented; the error is reported
+    directly from the signal handler.
+
+    See the file COPYING.FPC, included in this distribution,
+    for details about the copyright.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+
+ **********************************************************************}
+
+procedure SignalToRunerror(Sig: longint; info : PSigInfo; SigContext:PSigContext); cdecl;
+var
+  res : word;
+begin
+  res:=0;
+  case sig of
+    SIGFPE:
+      res:=207;
+    SIGILL,
+    SIGBUS,
+    SIGSEGV:
+      res:=216;
+    SIGINT:
+      res:=217;
+    SIGQUIT:
+      res:=233;
+  end;
+  reenable_signal(sig);
+  if res<>0 then
+    HandleErrorAddrFrame(res,nil,nil);
+end;
