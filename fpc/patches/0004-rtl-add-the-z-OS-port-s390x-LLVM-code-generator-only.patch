+
+Const
+  SIGHUP     =  1;
+  SIGINT     =  2;
+  SIGABRT    =  3;
+  SIGILL     =  4;
+  SIGPOLL    =  5;
+  SIGURG     =  6;
+  SIGSTOP    =  7;
+  SIGFPE     =  8;
+  SIGKILL    =  9;
+  SIGBUS     = 10;
+  SIGSEGV    = 11;
+  SIGSYS     = 12;
+  SIGPIPE    = 13;
+  SIGALRM    = 14;
+  SIGTERM    = 15;
+  SIGUSR1    = 16;
+  SIGUSR2    = 17;
+  SIGCONT    = 19;
+  SIGCHLD    = 20;
+  SIGTTIN    = 21;
+  SIGTTOU    = 22;
+  SIGIO      = 23;
+  SIGQUIT    = 24;
+  SIGTSTP    = 25;
+  SIGTRAP    = 26;
+  SIGWINCH   = 28;
+  SIGXCPU    = 29;
+  SIGXFSZ    = 30;
+  SIGVTALRM  = 31;
+  SIGPROF    = 32;
+
+  SIGIOT     = SIGABRT;
+  SIGCLD     = SIGCHLD;
+
+  SIG_BLOCK   = 0;
+  SIG_UNBLOCK = 1;
+  SIG_SETMASK = 2;
+
+  SIG_DFL = pointer(0);
+  SIG_IGN = pointer(1);
+  SIG_ERR = pointer(-1);
+
+  { sa_flags }
+  SA_NOCLDSTOP = cint($80000000);
+  SA_ONSTACK   = $20000000;
+  SA_RESETHAND = $10000000;
+  SA_RESTART   = $08000000;
+  SA_SIGINFO   = $04000000;
+  SA_NODEFER   = $01000000;
+
+  { si_code values for SIGFPE are not needed by the RTL on z/OS (the
+    runtime error is derived from the signal only) }
+
+type
+  { sigset_t: 8 bytes; always manipulated through the C library }
+  SigSet  = array[0..wordsinsigset-1] of cuint;
+  sigset_t= SigSet;
+  PSigSet = ^SigSet;
+  psigset_t=psigset;
+  TSigSet = SigSet;
+
+  { siginfo_t (64 bytes) }
+  psiginfo = ^tsiginfo;
+  tsiginfo = record
+       si_signo : cint;
+       si_errno : cint;
+       si_code  : cint;
+       __pad0   : array[0..27] of byte;
+       si_addr  : pointer;
+       __pad1   : array[0..15] of byte;
+    end;
+
+{ CPU dependent TSigContext }
+{$i sighndh.inc}
+
+type
+  SignalHandler   = Procedure(Sig : Longint);cdecl;
+  PSignalHandler  = ^SignalHandler;
+  SignalRestorer  = Procedure;cdecl;
+  PSignalRestorer = ^SignalRestorer;
+  SigActionHandler = procedure(sig : longint; SigInfo: PSigInfo; SigContext: PSigContext);cdecl;
+
+  { struct sigaction (32 bytes) }
+  SigActionRec = record
+    sa_handler  : SigActionHandler;
+    Sa_Mask     : SigSet;
+    Sa_Flags    : cint;
+    __pad       : array[0..11] of byte;
+  end;
