diff --git a/rtl/s390x/s390x.inc b/rtl/s390x/s390x.inc
new file mode 100644
index 00000000..8e523f58
--- /dev/null
+++ b/rtl/s390x/s390x.inc
@@ -0,0 +1,113 @@
+{
+    This file is part of the Free Pascal run time library.
+    Copyright (c) 2026 by the Free Pascal development team.
+
+    Processor dependent implementation for the system unit for
+    s390x (z/Architecture)
+
+    The s390x port only supports the LLVM code generator, so there are no
+    assembler routines: everything that is not implemented here comes from
+    the generic Pascal implementations.
+
+    See the file COPYING.FPC, included in this distribution,
+    for details about the copyright.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+
+ **********************************************************************}
+
+{****************************************************************************
+                                  FPU
+****************************************************************************}
+
+{$define FPC_SYSTEM_HAS_SYSINITFPU}
+procedure SysInitFPU;
+  begin
+    softfloat_rounding_mode:=rmNearest;
+    softfloat_exception_mask:=[float_flag_underflow,float_flag_inexact,float_flag_denormal];
+    softfloat_exception_flags:=[];
+  end;
+
+
+{$define FPC_SYSTEM_HAS_SYSRESETFPU}
+procedure SysResetFPU;{$ifdef SYSTEMINLINE}inline;{$endif}
+  begin
+    softfloat_exception_flags:=[];
+  end;
+
+
+function GetNativeFPUControlWord: TNativeFPUControlWord;{$ifdef SYSTEMINLINE}inline;{$endif}
+  begin
+  end;
+
+
+procedure SetNativeFPUControlWord(const cw: TNativeFPUControlWord);{$ifdef SYSTEMINLINE}inline;{$endif}
+  begin
+  end;
+
+
+{****************************************************************************
+                              Atomic operations
+****************************************************************************}
+
+{ implemented in C (zos-pascal-llvm: runtime/zosatomic.c), clang generates
+  compare and swap instructions for them }
+function c_atomic_cmp_xchg_32(var Target: longint; NewValue: longint; Comparand: longint): longint; cdecl; external name 'FPC_ATOMIC_CMP_XCHG_32';
+function c_atomic_cmp_xchg_64(var Target: int64; NewValue: int64; Comparand: int64): int64; cdecl; external name 'FPC_ATOMIC_CMP_XCHG_64';
+
+{$define FPC_SYSTEM_HAS_ATOMIC_CMP_XCHG_32}
+function fpc_atomic_cmp_xchg_32(var Target: longint; NewValue: longint; Comparand: longint): longint; compilerproc;
+  begin
+    result:=c_atomic_cmp_xchg_32(Target,NewValue,Comparand);
+  end;
+
+
+{$define FPC_SYSTEM_HAS_ATOMIC_CMP_XCHG_64}
+function fpc_atomic_cmp_xchg_64(var Target: int64; NewValue: int64; Comparand: int64): int64; compilerproc;
+  begin
+    result:=c_atomic_cmp_xchg_64(Target,NewValue,Comparand);
+  end;
+
+
+{****************************************************************************
+                       Caller/StackFrame Helpers
+****************************************************************************}
+
+{ Stack walking is not implemented yet (XPLINK frames have no frame pointer
+  chain that LLVM maintains). As on wasm32 a small fake backtrace is
+  produced, otherwise programs terminate with no output at all in case of a
+  runtime error. }
+
+{$define FPC_SYSTEM_HAS_GET_PC_ADDR}
+function Get_pc_addr : CodePointer;
+  begin
+    result:=CodePointer($eeeeeeef);
+  end;
+
+
+{$define FPC_SYSTEM_HAS_GET_CALLER_ADDR}
+function get_caller_addr(framebp:pointer;addr:codepointer=nil):pointer;
+  begin
+    if addr=CodePointer($eeeeeeef) then
+      result:=CodePointer($eeeeeeee)
+    else
+      result:=nil;
+  end;
+
+
+{$define FPC_SYSTEM_HAS_GET_CALLER_FRAME}
+function get_caller_frame(framebp:pointer;addr:codepointer=nil):pointer;
+  begin
+    result:=nil;
+  end;
+
+
+{$define FPC_SYSTEM_HAS_SPTR}
+function Sptr : pointer;
+  var
+    marker: byte;
+  begin
+    result:=@marker;
+  end;
