@@ -0,0 +1,94 @@
+{
+    This file is part of the Free Pascal run time library.
+    Copyright (c) 2002 Marco van de Voort
+    member of the Free Pascal development team.
+
+    The "linux" posixy macro's that are used both in the Baseunix unit as the
+    system unit. Not aliased via public names because I want these to be
+    inlined as much as possible in the future.
+
+    See the file COPYING.FPC, included in this distribution,
+    for details about the copyright.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+
+ **********************************************************************}
+
+function FpS_ISDIR(m : TMode): boolean;
+
+begin
+  FpS_ISDIR:=((m and S_IFMT) = S_IFDIR);
+end;
+
+function FpS_ISCHR(m : TMode): boolean;
+begin
+  FpS_ISCHR:=((m and S_IFMT) = S_IFCHR);
+end;
+
+function FpS_ISBLK(m : TMode): boolean;
+begin
+ FpS_ISBLK:=((m and S_IFMT) = S_IFBLK);
+end;
+
+function FpS_ISREG(m : TMode): boolean;
+begin
+ FpS_ISREG:=((m and S_IFMT) = S_IFREG);
+end;
+
+function FpS_ISFIFO(m : TMode): boolean;
+begin
+ FpS_ISFIFO:=((m and S_IFMT) = S_IFIFO);
+end;
+
+Function FPS_ISLNK(m:TMode):boolean;
+
+begin
+ FPS_ISLNK:=((m and S_IFMT) = S_IFLNK);
+end;
+
+Function FPS_ISSOCK(m:TMode):boolean;
+
+begin
+ FPS_ISSOCK:=((m and S_IFMT) = S_IFSOCK);
+end;
+
+{ wait status macros as in the z/OS header sys/wait.h }
+function wifexited(status : cint): boolean;
+begin
+ wifexited:=(status AND $FF) =0;
+end;
+
+function wexitstatus(status : cint): cint;
+begin
+ wexitstatus:=(status and $FF00) shr 8;
+end;
+
+function wstopsig(status : cint): cint;
+begin
+ wstopsig:=(status and $FF00) shr 8;
+end;
+
+function wifstopped_zos(status : cint): boolean;
+begin
+ case status and $FF of
+   $7F,$7E,$7D,$7B,$7A,$78,$77:
+     wifstopped_zos:=true;
+   else
+     wifstopped_zos:=false;
+ end;
+end;
+
+function wifsignaled(status : cint): boolean;
+begin
+ wifsignaled:=not wifstopped_zos(status) and
+   ((status and $FF)<>0) and ((status and $FF)<>$79);
+end;
+
+function wtermsig(status : cint):cint;
+
+begin
+ wtermsig:=cint(status and 127);
+end;
+
diff --git a/rtl/zos/ostypes.inc b/rtl/zos/ostypes.inc
new file mode 100644
index 00000000..5e190b9c
--- /dev/null
+++ b/rtl/zos/ostypes.inc
@@ -0,0 +1,230 @@
+{
+    This file is part of the Free Pascal run time library.
+    Copyright (c) 2026 by the Free Pascal development team
+
+    OS specific types and constants for z/OS UNIX System Services
+    (64 bit, XPLINK, ASCII mode).
+
+    Layouts and values were determined on z/OS with a C probe
+    (zos-pascal-llvm: pf1/probe/zosprobe.c). Padding fields make the
+    records match the C layout exactly; many z/OS structures contain
+    additional fields not needed by the RTL.
+
+    See the file COPYING.FPC, included in this distribution,
+    for details about the copyright.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+
+ **********************************************************************}
+
+{$i ptypes.inc}
+
+CONST
+   FD_MAXFDSET     = 2047;          { fd_set has 256 bytes }
+   BITSINWORD      = 8*sizeof(cuint);
+   wordsinsigset   = 2;             { sigset_t has 8 bytes }
+   wordsinfdset    = (FD_MAXFDSET+1+BITSINWORD-1) DIV BITSINWORD;
+   ln2bitsinword   = 5;
+   ln2bitmask      = 1 shl ln2bitsinword - 1;
+
+   UTSNAME_LENGTH = 32;
+
+TYPE
+   { struct stat (216 bytes) }
+   stat = record
+     st_eye     : array[0..3] of AnsiChar;  { eye catcher }
+     st_length  : cushort;
+     st_version : cushort;
+     st_mode    : mode_t;
+     st_ino     : ino_t;
+     st_dev     : dev_t;
+     st_nlink   : nlink_t;
+     st_uid     : uid_t;
+     st_gid     : gid_t;
+     st_size    : off_t;
+     __pad0     : array[0..11] of byte;   { 31 bit time fields }
+     st_rdev    : dev_t;
+     __pad1     : array[0..7] of byte;
+     st_blksize : blksize_t;
+     __pad2     : array[0..35] of byte;
+     st_blocks  : blkcnt_t;
+     __pad3     : array[0..39] of byte;
+     st_atime   : time_t;
+     st_mtime   : time_t;
+     st_ctime   : time_t;
+     __pad4     : array[0..39] of byte;
+   end;
+   TStat             = Stat;
+   PStat             = ^Stat;
+
+   flock    = record
+                l_type  : cshort;       { lock type: read/write, etc. }
+                l_whence: cshort;       { type of l_start }
+                l_start : off_t;        { starting offset }
+                l_len   : off_t;        { len = 0 means until end of file }
+                l_pid   : pid_t;        { lock owner }
+                end;
+   TFlock   = flock;
+   pFlock   = ^flock;
+
+   TFDSetEl = cuint;
+   TFDSet    = array[0..wordsinfdset-1] of TFDSetEl;
+   pFDSet    = ^TFDSet;
+
+   timezone = record
+     tz_minuteswest,tz_dsttime:cint;
+   end;
+   ptimezone =^timezone;
+   TTimeZone = timezone;
+
+   { struct utsname (80 bytes) }
+   utsname = record
+     sysname  : array[0..15] of AnsiChar;
+     nodename : array[0..31] of AnsiChar;
+     release  : array[0..7] of AnsiChar;
+     version  : array[0..7] of AnsiChar;
+     machine  : array[0..15] of AnsiChar;
+   end;
+
+   UTimBuf   = Record
+                 actime  : time_t;
+                 modtime : time_t;
+                end;
+   TUtimBuf  = UtimBuf;
+   pUtimBuf  = ^UtimBuf;
+
+   { struct dirent (272 bytes) }
+   pdirent = ^dirent;
+   dirent = record
+     __pad0   : array[0..3] of byte;
+     d_ino    : ino_t;
+     __pad1   : array[0..7] of byte;
+     d_name   : array[0..255] of AnsiChar;
+   end;
+
+   { DIR is opaque on z/OS }
+   pdir = ^dir;
+   dir = record
+   end;
+
+CONST
+    { access }
+    F_OK        = 8;
+    R_OK        = 4;
+    W_OK        = 2;
+    X_OK        = 1;
+
+    SEEK_SET    = 0;
+    SEEK_CUR    = 1;
+    SEEK_END    = 2;
+
+    { open }
+    O_RDONLY    = 2;
+    O_WRONLY    = 1;
+    O_RDWR      = 3;
+    O_ACCMODE   = 3;
+    O_CREAT     = $80;
+    O_EXCL      = $40;
+    O_NOCTTY    = $20;
+    O_TRUNC     = $10;
+    O_APPEND    = $08;
+    O_NONBLOCK  = $04;
+    O_SYNC      = $100;
+
+    { mode_t; note that the file type is in the high byte on z/OS }
+    S_IFMT   = $FF000000;
+    S_IFIFO  = $04000000;
+    S_IFCHR  = $02000000;
+    S_IFDIR  = $01000000;
+    S_IFBLK  = $06000000;
+    S_IFREG  = $03000000;
+    S_IFLNK  = $05000000;
+    S_IFSOCK = $07000000;
+
+    S_ISUID = &4000;
+    S_ISGID = &2000;
+    S_ISVTX = &1000;
+    S_IRUSR = &400;
+    S_IWUSR = &200;
+    S_IXUSR = &100;
+    S_IRGRP = &40;
+    S_IWGRP = &20;
+    S_IXGRP = &10;
+    S_IROTH = &4;
+    S_IWOTH = &2;
+    S_IXOTH = &1;
+
+    WNOHANG   = $01;
+    WUNTRACED = $02;
+
+    { fcntl }
+    F_DupFd  = 0;
+    F_GetFd  = 1;
+    F_SetFd  = 2;
+    F_GetFl  = 259;
+    F_SetFl  = 4;
+    F_GetLk  = 5;
+    F_SetLk  = 6;
+    F_SetLkW = 7;
+    FD_CLOEXEC = 1;
+    F_RDLCK  = 1;
+    F_WRLCK  = 2;
+    F_UNLCK  = 3;
+
+    { mmap }
+    PROT_READ  = 1;
+    PROT_WRITE = 2;
+    PROT_EXEC  = 8;
+    PROT_NONE  = 4;
+    MAP_SHARED  = 2;
+    MAP_PRIVATE = 1;
+    MAP_FIXED   = 4;
+    MAP_FAILED  = pointer(-1);
+
+type
+  rlim_t = cULong;
+  PRLimit = ^TRLimit;
+  TRLimit = record
+    rlim_cur : rlim_t;
+    rlim_max : rlim_t;
+  end;
+
+  iovec = record
+            iov_base : pointer;
+            iov_len  : size_t;
+           end;
+  tiovec=iovec;
+  piovec=^tiovec;
+
+  tms = record
+         tms_utime  : clock_t;  { User CPU time }
+         tms_stime  : clock_t;  { System CPU time }
+         tms_cutime : clock_t;  { User CPU time of terminated child procs }
+         tms_cstime : clock_t;  { System CPU time of terminated child procs }
+        end;
+  TTms= tms;
+  pTms= ^tms;
+
+const
+  POLLIN      = $0003;
+  POLLPRI     = $0010;
+  POLLOUT     = $0004;
+  POLLERR     = $0020;
+  POLLHUP     = $0040;
+  POLLNVAL    = $0080;
+
+type
+  pollfd = record
+    fd: cint;
+    events: cshort;
+    revents: cshort;
+  end;
+  tpollfd = pollfd;
+  ppollfd = ^pollfd;
+
+type
+  TTimespecArr  = array[0..1] of ttimespec;
+
+{$i signal.inc}
diff --git a/rtl/zos/pthread.inc b/rtl/zos/pthread.inc
