From 7a0e7d06db0a83af8fbdc648ede9ea0582f67a8f Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Mon, 28 Sep 2026 12:00:25 +0200
Subject: [PATCH 31/35] rtl/zos: record I/O and VSAM (unit zosrecio), data sets
 in SysUtils

- New unit zosrecio: records of MVS data sets and VSAM clusters (KSDS,
  ESDS, RRDS) through the C library (type=record): read, write, locate by
  key, update and delete; record format and key from fldata.
- SysUtils.FileExists, DeleteFile and RenameFile handle data set names
  (//'HLQ.NAME', //NAME, DD:NAME).
- Libraries: dsntype=library / dsntype=pds in the attributes of a new
  data set allocate the PDSE / PDS with dynalloc first (runtime/zosdsn.c).

Assisted-by: Claude Code (Anthropic)
---
 rtl/unix/sysutils.pp |  13 ++++
 rtl/zos/system.pp    |   1 +
 rtl/zos/zosrecio.pp  | 159 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 173 insertions(+)
 create mode 100755 rtl/zos/zosrecio.pp

diff --git a/rtl/unix/sysutils.pp b/rtl/unix/sysutils.pp
index 83ec08cf..8bd79784 100644
--- a/rtl/unix/sysutils.pp
+++ b/rtl/unix/sysutils.pp
@@ -772,6 +772,11 @@ function FileGetSymLinkTarget(const FileName: RawByteString; out SymLinkRec: TRa
   if Filename='' then
     Exit(False);
   SystemFileName:=ToSingleByteFileSystemEncodedFileName(FileName);
+{$ifdef zos}
+  { MVS data set, member or DD statement (//'HLQ.NAME', DD:NAME) }
+  if zos_dsn_name(PAnsiChar(SystemFileName))<>0 then
+    Exit(zos_dsn_exists(PAnsiChar(SystemFileName))<>0);
+{$endif zos}
   // Don't use stat. It fails on files >2 GB.
   // Access obeys the same access rules, so the result should be the same.
   FileExists:=fpAccess(pointer(SystemFileName),F_OK)=0;
@@ -1275,6 +1280,10 @@ function zos_futimes(fd: cint; const times: TZosTimeValArr): cint; cdecl; extern
   SystemFileName: RawByteString;
 begin
   SystemFileName:=ToSingleByteFileSystemEncodedFileName(FileName);
+{$ifdef zos}
+  if zos_dsn_name(PAnsiChar(SystemFileName))<>0 then
+    Exit(zos_dsn_erase(PAnsiChar(SystemFileName))=0);
+{$endif zos}
   Result:=fpUnLink (PAnsiChar(SystemFileName))>=0;
 end;
 
@@ -1285,6 +1294,10 @@ function zos_futimes(fd: cint; const times: TZosTimeValArr): cint; cdecl; extern
 begin
   SystemOldName:=ToSingleByteFileSystemEncodedFileName(OldName);
   SystemNewName:=ToSingleByteFileSystemEncodedFileName(NewName);
+{$ifdef zos}
+  if zos_dsn_name(PAnsiChar(SystemOldName))<>0 then
+    Exit(zos_dsn_rename(PAnsiChar(SystemOldName),PAnsiChar(SystemNewName))=0);
+{$endif zos}
   RenameFile:=BU.FpRename(pointer(SystemOldName),pointer(SystemNewName))>=0;
 end;
 
