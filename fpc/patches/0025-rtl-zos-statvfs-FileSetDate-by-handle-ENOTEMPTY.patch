From 28395d0306f0e52b2b1cf1b6862ebda786b0d804 Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Mon, 28 Sep 2026 09:38:35 +0200
Subject: [PATCH 25/30] rtl/zos: statvfs, FileSetDate by handle, ENOTEMPTY

- fpStatFS called statfs, which the z/OS C library does not provide in
  this form (DiskFree/DiskSize crashed); use statvfs like fpfStatFS
- FileSetDate(Handle) was not implemented (no futimens on z/OS); use
  futimes (@@FUTIME)
- ENOTEMPTY maps to IOResult 5, as on Linux

FPC testsuite: test/units/dos/tdos, test/units/sysutils/tfile1.

Assisted-by: Claude Code (Anthropic)
---
 rtl/unix/sysutils.pp  | 19 +++++++++++++++++++
 rtl/unix/unxdeclh.inc |  2 +-
 rtl/zos/sysos.inc     |  1 +
 3 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/rtl/unix/sysutils.pp b/rtl/unix/sysutils.pp
index de7a901e..83ec08cf 100644
--- a/rtl/unix/sysutils.pp
+++ b/rtl/unix/sysutils.pp
@@ -1208,13 +1208,32 @@ function FileGetSymLinkTarget(const FileName: RawByteString; out SymLinkRec: TRa
 end;
 
 
+{$ifdef zos}
+{ z/OS has no futimens, but futimes (microseconds); no ASCII variant needed }
+type
+  TZosTimeValArr = array[0..1] of TTimeVal;
+function zos_futimes(fd: cint; const times: TZosTimeValArr): cint; cdecl; external name '@@FUTIME';
+{$endif zos}
+
 Function FileSetDate (Handle : Longint;Age : Int64) : Longint;
 {$ifdef USE_FUTIMES}
 var
   times : TTimespecArr;
 {$endif USE_FUTIMES}
+{$ifdef zos}
+var
+  tv : TZosTimeValArr;
+{$endif zos}
 begin
   Result:=0;
+{$ifdef zos}
+  FillChar(tv,sizeof(tv),0);
+  tv[0].tv_sec:=Age;
+  tv[1].tv_sec:=Age;
+  if zos_futimes(Handle,tv) = -1 then
+    Result:=fpgeterrno;
+  exit;
+{$endif zos}
 {$ifdef USE_FUTIMES}
   times[0].tv_sec:=Age;
   times[0].tv_nsec:=0;
diff --git a/rtl/unix/unxdeclh.inc b/rtl/unix/unxdeclh.inc
index 8d4db198..d1cf8bdf 100644
--- a/rtl/unix/unxdeclh.inc
+++ b/rtl/unix/unxdeclh.inc
@@ -38,7 +38,7 @@
 
 Function fpfsync (fd : cint) : cint; cdecl; external clib name 'fsync';
 
-{$if defined(beos) or defined(solaris) }
+{$if defined(beos) or defined(solaris) or defined(zos)}
 Function fpStatFS  (Path:PAnsiChar; Info:pstatfs):cint; cdecl; external clib name 'statvfs';
 {$else beos or solaris }
 Function fpStatFS  (Path:PAnsiChar; Info:pstatfs):cint; cdecl; external clib name 'statfs'{$ifdef darin_new_iostructs_suffix}+'$INODE64'{$endif};
diff --git a/rtl/zos/sysos.inc b/rtl/zos/sysos.inc
index 1710e0c0..37741411 100644
--- a/rtl/zos/sysos.inc
+++ b/rtl/zos/sysos.inc
@@ -71,6 +71,7 @@ procedure seterrno(err:libcint); [public, alias: 'FPC_SYS_SETERRNO'];
  ESysENAMETOOLONG : Inoutres := 3;
     ESysEROFS,
    ESysEEXIST,
+   ESysENOTEMPTY,      // as on Linux
    ESysEBusy,
    ESysENOTDIR,        // busy, enotdir, mantis #25931
    ESysEACCES : Inoutres:=5;
