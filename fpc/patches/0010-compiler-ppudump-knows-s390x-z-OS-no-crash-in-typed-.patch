From 4a18bb009c9824b04efb03c22e6400b3a290507b Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Sun, 27 Sep 2026 15:55:34 +0200
Subject: [PATCH 10/36] compiler: ppudump knows s390x/z/OS; no crash in typed
 dynarray consts after errors

- ppudump: CPU s390x and target zOS-s390x in its tables (the utils did not
  build any more)
- LLVM typed constants: after an error in the element type (incompletely
  defined record, tbf/tb0265) the data field is not found -> do not
  dereference nil, only an internal error if no error was reported before

Assisted-by: Claude Code (Anthropic)
---
 compiler/llvm/nllvmtcon.pas        | 11 ++++++++++-
 compiler/utils/ppuutils/ppudump.pp |  9 ++++++---
 2 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/compiler/llvm/nllvmtcon.pas b/compiler/llvm/nllvmtcon.pas
index 38a62cca..e62bced0 100644
--- a/compiler/llvm/nllvmtcon.pas
+++ b/compiler/llvm/nllvmtcon.pas
@@ -129,7 +129,7 @@     tllvmtai_typedconstbuilder = class(ttai_typedconstbuilder)
 implementation
 
   uses
-    verbose,systems,fmodule,globals,
+    verbose,comphook,systems,fmodule,globals,
     aasmdata,
     procinfo,
     cpubase,cpuinfo,llvmbase,llvminfo,
@@ -482,6 +482,15 @@ implementation
         begin
           { field corresponding to this offset }
           field:=trecordsymtable(arrconstdatadef.symtable).findfieldbyoffset(ll.ofs);
+          { no field after an earlier error in the element type (e.g. an
+            incompletely defined record, tbf/tb0265) }
+          if not assigned(field) then
+            begin
+              if status.errorcount=0 then
+                internalerror(2026092701);
+              inherited;
+              exit;
+            end;
           { pointerdef to the string data array }
           dataptrdef:=cpointerdef.getreusable(field.vardef);
           { the fields of the resourcestring record are declared as ansistring }
diff --git a/compiler/utils/ppuutils/ppudump.pp b/compiler/utils/ppuutils/ppudump.pp
index 51765925..2ac17bca 100644
--- a/compiler/utils/ppuutils/ppudump.pp
+++ b/compiler/utils/ppuutils/ppudump.pp
@@ -90,7 +90,8 @@
     { 22 } 'z80',
     { 23 } 'mips64',
     { 24 } 'mips64el',
-    { 25 } 'loongarch64'
+    { 25 } 'loongarch64',
+    { 26 } 's390x'
     );
 
   CpuHasController : array[tsystemcpu] of boolean =
@@ -120,7 +121,8 @@
     { 22 } true  {'z80'},
     { 23 } false {'mips64'},
     { 24 } false {'mips64el'},
-    { 25 } false {'loongarch64'}
+    { 25 } false {'loongarch64'},
+    { 26 } false {'s390x'}
     );
 
 { List of all supported system-cpu couples }
@@ -252,7 +254,8 @@
   { 123 } 'PS1-mipsel',
   { 124 } 'WASIp1threads-WASM32',
   { 125 } 'WASIp2-WASM32',
-  { 126 } 'FreeBSD-powerpc64'
+  { 126 } 'FreeBSD-powerpc64',
+  { 127 } 'zOS-s390x'
   );
 
 const
-- 
2.43.0

