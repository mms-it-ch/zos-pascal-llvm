From d92278f84e9e03a32fe92bef1c0b529cb76944e2 Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Mon, 28 Sep 2026 10:51:05 +0200
Subject: [PATCH 29/36] packages: z/OS support (pthreads, sockets, netdb,
 pipes)

- pthreads: use the declarations of the run time library
  (rtl/zos/pthread.inc) and the usual names of the mutex types.
- rtl-extra: osdefs.inc and unxsockh.inc for z/OS (constants generated
  from the z/OS headers); sockaddr has a length byte (SOCK_HAS_SINLEN).
  MSG_NOSIGNAL does not exist on z/OS (0).
- cnetdb: struct addrinfo has ai_canonname before ai_addr and an
  additional ai_eflags field, which getaddrinfo reads from the hints.
- fcl-process: z/OS rejects FIONREAD on pipes (EINVAL); the number of
  waiting bytes is st_size of fstat (RunCommand read nothing before).

Assisted-by: Claude Code (Anthropic)
---
 packages/fcl-net/src/cnetdb.pp          |   7 +-
 packages/fcl-process/src/unix/pipes.inc |  14 ++-
 packages/pthreads/src/pthreads.pp       |   9 ++
 packages/rtl-extra/src/unix/sockets.pp  |   3 +-
 packages/rtl-extra/src/zos/osdefs.inc   |  13 ++
 packages/rtl-extra/src/zos/unxsockh.inc | 160 ++++++++++++++++++++++++
 6 files changed, 203 insertions(+), 3 deletions(-)
 create mode 100644 packages/rtl-extra/src/zos/osdefs.inc
 create mode 100644 packages/rtl-extra/src/zos/unxsockh.inc

diff --git a/packages/fcl-net/src/cnetdb.pp b/packages/fcl-net/src/cnetdb.pp
index 0d7df265..44f4fda2 100644
--- a/packages/fcl-net/src/cnetdb.pp
+++ b/packages/fcl-net/src/cnetdb.pp
@@ -240,7 +240,7 @@   protoent = record
 {$if defined(LINUX) or defined(OPENBSD) or defined(DARWIN)}
 {$define FIRST_ADDR_THEN_CANONNAME}
 {$endif}
-{$if defined(FREEBSD) or defined(NETBSD) or defined(DRAGONFLY) or defined(SOLARIS) or defined(ANDROID)}
+{$if defined(FREEBSD) or defined(NETBSD) or defined(DRAGONFLY) or defined(SOLARIS) or defined(ANDROID) or defined(ZOS)}
 {$define FIRST_CANONNAME_THEN_ADDR}
 {$endif}
 {$if not defined(FIRST_CANONNAME_THEN_ADDR) and not defined(FIRST_ADDR_THEN_CANONNAME)}
@@ -263,6 +263,11 @@   addrinfo = record
     ai_canonname: PAnsiChar;   {* canonical name for hostname *}
 {$endif}
     ai_next: PAddrInfo;	   {* next structure in linked list *}
+{$ifdef ZOS}
+    { z/OS: source IP address preferences; getaddrinfo reads it from the
+      hints (the reserved int after ai_addrlen fills the alignment gap) }
+    ai_eflags: cInt;
+{$endif}
   end;
   TAddrInfo = addrinfo;
   PPAddrInfo = ^PAddrInfo;
diff --git a/packages/fcl-process/src/unix/pipes.inc b/packages/fcl-process/src/unix/pipes.inc
index 158bcbe1..32b9f836 100644
--- a/packages/fcl-process/src/unix/pipes.inc
+++ b/packages/fcl-process/src/unix/pipes.inc
@@ -29,8 +29,20 @@
 
 
 Function TInputPipeStream.GetNumBytesAvailable: DWord;
-
+{$ifdef zos}
+var
+  st: stat;
+{$endif zos}
 begin
+{$ifdef zos}
+  { z/OS rejects FIONREAD on pipes (EINVAL); fstat returns the number of
+    bytes waiting in a pipe as st_size }
+  if (fpfstat(Handle, st)=0) and fpS_ISFIFO(st.st_mode) then
+    begin
+      Result := st.st_size;
+      exit;
+    end;
+{$endif zos}
   if fpioctl(Handle, FIONREAD, @Result)<0 then
     Result := 0;
 end;
diff --git a/packages/pthreads/src/pthreads.pp b/packages/pthreads/src/pthreads.pp
index ae65dd4b..07fef731 100644
--- a/packages/pthreads/src/pthreads.pp
+++ b/packages/pthreads/src/pthreads.pp
@@ -61,6 +61,15 @@ interface
   {$else}
     {$i pthrbeos.inc}
   {$endif}
+{$elseif defined(zos)}
+  { the declarations of the run time library (rtl/zos/pthread.inc, also used by
+    cthreads) }
+  uses initc, ctypes, baseunix, unixtype;
+  {$i pthread.inc}
+  const
+    PTHREAD_MUTEX_NORMAL     = _PTHREAD_MUTEX_NORMAL;
+    PTHREAD_MUTEX_ERRORCHECK = _PTHREAD_MUTEX_ERRORCHECK;
+    PTHREAD_MUTEX_RECURSIVE  = _PTHREAD_MUTEX_RECURSIVE;
 {$elseif defined(aix)}
 {$IFDEF FPC_DOTTEDUNITS}
   uses System.InitC, System.CTypes, UnixApi.Base, UnixApi.Types;
diff --git a/packages/rtl-extra/src/unix/sockets.pp b/packages/rtl-extra/src/unix/sockets.pp
index 28ee7123..f73def75 100644
--- a/packages/rtl-extra/src/unix/sockets.pp
+++ b/packages/rtl-extra/src/unix/sockets.pp
@@ -33,7 +33,8 @@
      defined(FreeBSD) or
      defined(Darwin) or
      defined(Haiku) or
-     defined(OpenBSD)
+     defined(OpenBSD) or
+     defined(zos)
 }
 {$DEFINE SOCK_HAS_SINLEN}               // BSD definition of socketaddr
 {$endif}
