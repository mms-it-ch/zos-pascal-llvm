+{$ifdef zos}
+{ z/OS: DIR is opaque, use the C library }
+procedure c_seekdir(p:pdir;loc:clong); cdecl; external clib name 'seekdir';
+function c_telldir(p:pdir):clong; cdecl; external clib name 'telldir';
+
+procedure SeekDir(p:pdir;loc:clong);
+begin
+  if p=nil then
+    fpseterrno(ESysEBADF)
+  else
+    c_seekdir(p,loc);
+end;
+
+function TellDir(p:pdir):TOff;
+begin
+  if p=nil then
+    begin
+      fpseterrno(ESysEBADF);
+      telldir:=-1;
+    end
+  else
+    telldir:=c_telldir(p);
+end;
+{$else zos}
 procedure SeekDir(p:pdir;loc:clong);
 begin
   if p=nil then
@@ -757,6 +781,7 @@ function TellDir(p:pdir):TOff;
