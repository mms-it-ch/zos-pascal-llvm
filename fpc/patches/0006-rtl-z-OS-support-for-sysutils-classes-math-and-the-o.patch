    PResourceStringTableList = ^TResourceStringTableList;
 
+{$ifdef zos}
+{ z/OS: the binder does not keep the table parts in order; the compiler
+  generates a list of pointers to the entries per unit (see cresstr.pas),
+  TableStart and TableEnd both point to it }
+{$define FPC_RESSTR_PTRLIST}
+{$endif zos}
+{$ifdef FPC_RESSTR_PTRLIST}
+   PResStrPtrList = ^TResStrPtrList;
+   TResStrPtrList = record
+     Count : SizeInt;
+     { Entries[0] is the unit name entry }
+     Entries : array[0..0] of PResourceStringRecord;
+   end;
+{$endif FPC_RESSTR_PTRLIST}
+
 { Support for string constants initialized with resourcestrings }
 {$ifdef FPC_HAS_RESSTRINITS}
    PResStrInitEntry = ^TResStrInitEntry;
@@ -429,12 +444,26 @@ procedure FinalizeResourceStringRefs;
 Var
   ResStr : PResourceStringRecord;
   i      : integer;
+{$ifdef FPC_RESSTR_PTRLIST}
+  j      : SizeInt;
+{$endif FPC_RESSTR_PTRLIST}
   s      : RTLString;
 begin
   With ResourceStringTable^ do
     begin
       For i:=0 to Count-1 do
         begin
+{$ifdef FPC_RESSTR_PTRLIST}
+          ResStr:=PResStrPtrList(Tables[I].TableStart)^.Entries[0];
+          { Skip first entry (name of the Unit) }
+          for j:=1 to PResStrPtrList(Tables[I].TableStart)^.Count do
+            begin
+              ResStr:=PResStrPtrList(Tables[I].TableStart)^.Entries[j];
+              s:=SetFunction(ResStr^.Name,ResStr^.DefaultValue,Longint(ResStr^.HashValue),arg);
+              if s<>'' then
+                ResStr^.CurrentValue:=s;
+            end;
+{$else FPC_RESSTR_PTRLIST}
           ResStr:=Tables[I].TableStart^;
           { Skip first entry (name of the Unit) }
           inc(ResStr);
@@ -445,6 +474,7 @@ procedure FinalizeResourceStringRefs;
                 ResStr^.CurrentValue:=s;
               inc(ResStr);
             end;
+{$endif FPC_RESSTR_PTRLIST}
         end;
     end;
