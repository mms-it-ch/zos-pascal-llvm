+{$else FPC_RESSTR_PTRLIST}
           ResStr:=Tables[I].TableStart^;
           { Check name of the Unit }
           if ResStr^.Name<>UpUnitName then
@@ -477,6 +523,7 @@ procedure FinalizeResourceStringRefs;
                 ResStr^.CurrentValue:=s;
               inc(ResStr);
             end;
+{$endif FPC_RESSTR_PTRLIST}
         end;
     end;
 {$ifdef FPC_HAS_RESSTRINITS}
@@ -491,11 +538,23 @@ procedure FinalizeResourceStringRefs;
