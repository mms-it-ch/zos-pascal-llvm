From ee3ed4b13b98fa9e2a174d8102f34cadbccea806 Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Sun, 27 Sep 2026 21:32:30 +0200
Subject: [PATCH 19/30] rtl/zos: open the DDs STDIN/STDOUT/STDERR as file
 descriptors in batch

A program started from JCL with POSIX(ON) has no open file descriptors
0, 1 and 2; only the C streams are connected to the DD statements. The
RTL writes to file descriptors, so the output was lost. At startup, each
closed descriptor is connected to its DD (STDIN, STDOUT, STDERR) if it
exists (runtime/zoscompat.c, FPC_ZOS_BATCH_STDIO).

Assisted-by: Claude Code (Anthropic)
---
 rtl/zos/system.pp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/rtl/zos/system.pp b/rtl/zos/system.pp
index 2018e93e..e6810313 100644
--- a/rtl/zos/system.pp
+++ b/rtl/zos/system.pp
@@ -59,6 +59,8 @@ procedure pascalmain;external name 'PASCALMAIN';
 
 { environ of the C library (runtime/zoscompat.c) }
 function zos_environ: PPAnsiChar; cdecl; external name 'FPC_ZOS_ENVIRON';
+{ batch (JCL): put the DDs STDIN/STDOUT/STDERR on file descriptors 0/1/2 }
+procedure zos_batch_stdio; cdecl; external name 'FPC_ZOS_BATCH_STDIO';
 
 { called by the main stub generated by the compiler (C main) }
 procedure FPC_SYSTEMMAIN(argcparam: Longint; argvparam: PPAnsiChar; envpparam: PPAnsiChar); cdecl; [public];
@@ -68,6 +70,7 @@ procedure FPC_SYSTEMMAIN(argcparam: Longint; argvparam: PPAnsiChar; envpparam: P
   argv:=argvparam;
   { LE calls main with argc and argv only, envpparam is undefined }
   envp:=zos_environ;
+  zos_batch_stdio;
   pascalmain;  {run the pascal main program}
 end;
 
