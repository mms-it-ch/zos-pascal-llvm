From df5c2d31842bdbef2f37930f64085f902d75c461 Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Mon, 28 Sep 2026 10:51:05 +0200
Subject: [PATCH 28/30] rtl/zos: semaphores, FIONREAD, unit zosebcdic

- The z/OS C library has no unnamed POSIX semaphores (sem_init, ...);
  they are emulated with a mutex and a condition variable
  (runtime/zoscompat.c), sem_t points to the emulation.
- termios: FIONREAD.
- New unit zosebcdic: conversion between EBCDIC (IBM-1047) and
  ISO-8859-1 (output of z/OS UNIX commands, data of other programs).

Assisted-by: Claude Code (Anthropic)
---
 rtl/zos/pthread.inc  | 18 +++++++------
 rtl/zos/termios.inc  |  2 ++
 rtl/zos/zosebcdic.pp | 61 ++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 73 insertions(+), 8 deletions(-)
 create mode 100644 rtl/zos/zosebcdic.pp

diff --git a/rtl/zos/pthread.inc b/rtl/zos/pthread.inc
index 7ef63589..9ea31704 100644
--- a/rtl/zos/pthread.inc
+++ b/rtl/zos/pthread.inc
@@ -38,7 +38,9 @@     sched_param = record
       __sched_reserved: array[0..5] of cint;
     end;
 
-    sem_t = cint;
+    { no unnamed POSIX semaphores in the z/OS C library: emulated in
+      runtime/zoscompat.c, sem_t points to the emulation }
+    sem_t = pointer;
 
     psem_t      = ^sem_t;
     TSemaphore  = sem_t;
@@ -111,15 +113,15 @@ function  pthread_cond_wait(_para1:Ppthread_cond_t;_para2:Ppthread_mutex_t):cint
 function pthread_kill(__thread:pthread_t; __signo:cint):cint;cdecl;external 'c';
 function pthread_sigmask(how: cint; nset: psigset; oset: psigset): cint; cdecl; external 'c';
 
-function sem_init(__sem:Psem_t; __pshared:cint;__value:cuint):cint;cdecl; external 'c' name 'sem_init';
-function sem_destroy(__sem:Psem_t):cint;cdecl;external 'c' name 'sem_destroy';
+function sem_init(__sem:Psem_t; __pshared:cint;__value:cuint):cint;cdecl; external name 'FPC_ZOS_SEM_INIT';
+function sem_destroy(__sem:Psem_t):cint;cdecl;external name 'FPC_ZOS_SEM_DESTROY';
 function sem_close(__sem:Psem_t):cint;cdecl;external 'c'  name 'sem_close';
 function sem_unlink(__name:PAnsiChar):cint;cdecl;external 'c' name 'sem_unlink';
-function sem_wait(__sem:Psem_t):cint;cdecl;external 'c'  name 'sem_wait';
-function sem_timedwait(__sem: Psem_t; const __timespec: ptimespec): cint;cdecl; external 'c' name 'sem_timedwait';
-function sem_trywait(__sem:Psem_t):cint;cdecl;external 'c'  name 'sem_trywait';
-function sem_post(__sem:Psem_t):cint;cdecl;external 'c'  name 'sem_post';
-function sem_getvalue(__sem:Psem_t; __sval:Pcint):cint;cdecl;external 'c'  name 'sem_getvalue';
+function sem_wait(__sem:Psem_t):cint;cdecl;external name 'FPC_ZOS_SEM_WAIT';
+function sem_timedwait(__sem: Psem_t; const __timespec: ptimespec): cint;cdecl; external name 'FPC_ZOS_SEM_TIMEDWAIT';
+function sem_trywait(__sem:Psem_t):cint;cdecl;external name 'FPC_ZOS_SEM_TRYWAIT';
+function sem_post(__sem:Psem_t):cint;cdecl;external name 'FPC_ZOS_SEM_POST';
+function sem_getvalue(__sem:Psem_t; __sval:Pcint):cint;cdecl;external name 'FPC_ZOS_SEM_GETVALUE';
 
 
 function pthread_mutexattr_init(_para1:Ppthread_mutexattr_t):cint;cdecl;external 'c' name 'pthread_mutexattr_init';
diff --git a/rtl/zos/termios.inc b/rtl/zos/termios.inc
index a1072458..813be116 100755
--- a/rtl/zos/termios.inc
+++ b/rtl/zos/termios.inc
@@ -57,6 +57,8 @@ function cfsetispeed(var _para1:termios; _para2:speed_t):longint;cdecl;external;
   { ioctl: _IOR/_IOW(163, 104/103, struct winsize) }
   TIOCGWINSZ = $4008a368;
   TIOCSWINSZ = $8008a367;
+  { sys/ioctl.h: _IOR(167, 127, int) }
+  FIONREAD   = $4004a77f;
 
   { speeds }
   B0 = 0;
diff --git a/rtl/zos/zosebcdic.pp b/rtl/zos/zosebcdic.pp
new file mode 100644
index 00000000..037be36f
--- /dev/null
+++ b/rtl/zos/zosebcdic.pp
@@ -0,0 +1,61 @@
+{
+    This file is part of the Free Pascal run time library.
+
+    z/OS: conversion between EBCDIC (IBM-1047) and ISO-8859-1, the character
+    set of the run time library (ASCII mode). Output of z/OS UNIX commands
+    (e.g. read from a pipe with TProcess) and data from other programs are
+    usually EBCDIC. Line ends: EBCDIC NL (X'15') <-> LF, as iconv on z/OS UNIX
+    and the text files on MVS data sets.
+
+    See the file COPYING.FPC, included in this distribution,
+    for details about the copyright.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+
+ **********************************************************************}
+unit zosebcdic;
+
+{$mode objfpc}{$H+}
+
+interface
+
+function EbcdicToAscii(const s: RawByteString): RawByteString;
+function AsciiToEbcdic(const s: RawByteString): RawByteString;
+procedure EbcdicToAsciiBuf(var buf; len: SizeInt);
+procedure AsciiToEbcdicBuf(var buf; len: SizeInt);
+
+implementation
+
+{ runtime/zosdsn.c }
+procedure zos_e2a(p: pointer; n: int64); cdecl; external name 'FPC_ZOS_E2A';
+procedure zos_a2e(p: pointer; n: int64); cdecl; external name 'FPC_ZOS_A2E';
+
+function EbcdicToAscii(const s: RawByteString): RawByteString;
+begin
+  result:=s;
+  UniqueString(result);
+  if length(result)>0 then
+    zos_e2a(@result[1],length(result));
+end;
+
+function AsciiToEbcdic(const s: RawByteString): RawByteString;
+begin
+  result:=s;
+  UniqueString(result);
+  if length(result)>0 then
+    zos_a2e(@result[1],length(result));
+end;
+
+procedure EbcdicToAsciiBuf(var buf; len: SizeInt);
+begin
+  zos_e2a(@buf,len);
+end;
+
+procedure AsciiToEbcdicBuf(var buf; len: SizeInt);
+begin
+  zos_a2e(@buf,len);
+end;
+
+end.
