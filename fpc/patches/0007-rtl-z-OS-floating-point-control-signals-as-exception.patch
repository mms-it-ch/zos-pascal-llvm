diff --git a/rtl/s390x/cpuh.inc b/rtl/s390x/cpuh.inc
index cb8746ac..d36dcf88 100644
--- a/rtl/s390x/cpuh.inc
+++ b/rtl/s390x/cpuh.inc
@@ -12,5 +12,22 @@
  **********************************************************************}
 
 type
-  TNativeFPUControlWord = record
-  end;
+  { floating point control register (FPC) }
+  TNativeFPUControlWord = dword;
+
+const
+  { FPC bits: IEEE trap enables, flags, data exception code, rounding mode }
+  fpc_trap_invalid   = $80000000;
+  fpc_trap_zerodiv   = $40000000;
+  fpc_trap_overflow  = $20000000;
+  fpc_trap_underflow = $10000000;
+  fpc_trap_inexact   = $08000000;
+  fpc_trap_mask      = $F8000000;
+  fpc_flag_invalid   = $00800000;
+  fpc_flag_zerodiv   = $00400000;
+  fpc_flag_overflow  = $00200000;
+  fpc_flag_underflow = $00100000;
+  fpc_flag_inexact   = $00080000;
+  fpc_flag_mask      = $00F80000;
+  fpc_dxc_mask       = $0000FF00;
+  fpc_round_mask     = $00000007;
