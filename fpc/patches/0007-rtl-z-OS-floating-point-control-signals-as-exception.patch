+    FPU control for s390x: the floating point control register (FPC) is
+    accessed through GetNativeFPUControlWord/SetNativeFPUControlWord
+    (see s390x.inc).
+
     See the file COPYING.FPC, included in this distribution,
     for details about the copyright.
 
@@ -11,41 +15,98 @@
 
  **********************************************************************}
 
-
-{ TODO: use fenv of the z/OS C runtime (fegetround/fesetround,
-  feenableexcept); fixed values as on wasm32 for now }
-
-
 function GetRoundMode: TFPURoundingMode;
-begin
-  GetRoundMode:=rmNearest;
-end;
+  const
+    bits2rm: array[0..3] of TFPURoundingMode = (rmNearest,rmTruncate,rmUp,rmDown);
+  begin
+    result:=bits2rm[GetNativeFPUControlWord and 3];
+  end;
+
 
 function SetRoundMode(const RoundMode: TFPURoundingMode): TFPURoundingMode;
-begin
-  SetRoundMode:=rmNearest;
-end;
+  const
+    rm2bits: array[TFPURoundingMode] of byte = (0,3,2,1);
+  begin
+    softfloat_rounding_mode:=RoundMode;
+    SetRoundMode:=GetRoundMode;
+    SetNativeFPUControlWord((GetNativeFPUControlWord and not fpc_round_mask) or rm2bits[RoundMode]);
+  end;
+
 
 function GetPrecisionMode: TFPUPrecisionMode;
-begin
-  GetPrecisionMode:=pmDouble;
-end;
+  begin
+    result:=pmDouble;
+  end;
+
 
 function SetPrecisionMode(const Precision: TFPUPrecisionMode): TFPUPrecisionMode;
-begin
-  SetPrecisionMode:=pmDouble;
-end;
+  begin
+    result:=pmDouble;
+  end;
+
 
 function GetExceptionMask: TFPUExceptionMask;
-begin
-  GetExceptionMask:=[exDenormalized,exOverflow,exPrecision];
-end;
+  var
+    fpc: dword;
+  begin
+    fpc:=GetNativeFPUControlWord;
+    result:=[exDenormalized];
+    if (fpc and fpc_trap_invalid)=0 then
+      include(result,exInvalidOp);
+    if (fpc and fpc_trap_zerodiv)=0 then
+      include(result,exZeroDivide);
+    if (fpc and fpc_trap_overflow)=0 then
+      include(result,exOverflow);
+    if (fpc and fpc_trap_underflow)=0 then
+      include(result,exUnderflow);
+    if (fpc and fpc_trap_inexact)=0 then
+      include(result,exPrecision);
+  end;
+
 
 function SetExceptionMask(const Mask: TFPUExceptionMask): TFPUExceptionMask;
-begin
-  SetExceptionMask:=[exDenormalized,exOverflow,exPrecision];
-end;
+  var
+    traps: dword;
+  begin
+    ClearExceptions(false);
+    result:=GetExceptionMask;
+    softfloat_exception_mask:=mask;
+    traps:=0;
+    if not(exInvalidOp in Mask) then
+      traps:=traps or fpc_trap_invalid;
+    if not(exZeroDivide in Mask) then
+      traps:=traps or fpc_trap_zerodiv;
+    if not(exOverflow in Mask) then
+      traps:=traps or fpc_trap_overflow;
+    if not(exUnderflow in Mask) then
+      traps:=traps or fpc_trap_underflow;
+    if not(exPrecision in Mask) then
+      traps:=traps or fpc_trap_inexact;
+    SetNativeFPUControlWord((GetNativeFPUControlWord and not fpc_trap_mask) or traps);
+  end;
+
 
 procedure ClearExceptions(RaisePending: Boolean);
-begin
-end;
+  var
+    fpc: dword;
+    f: TFPUException;
+  begin
+    fpc:=GetNativeFPUControlWord;
+    if RaisePending then
+      begin
+        if (fpc and fpc_flag_zerodiv)<>0 then
+          float_raise(exZeroDivide);
+        if (fpc and fpc_flag_overflow)<>0 then
+          float_raise(exOverflow);
+        if (fpc and fpc_flag_underflow)<>0 then
+          float_raise(exUnderflow);
+        if (fpc and fpc_flag_invalid)<>0 then
+          float_raise(exInvalidOp);
+        if (fpc and fpc_flag_inexact)<>0 then
+          float_raise(exPrecision);
+        for f in softfloat_exception_flags do
+          float_raise(f);
+      end;
+    softfloat_exception_flags:=[];
+    SetNativeFPUControlWord(fpc and not (fpc_flag_mask or fpc_dxc_mask));
+  end;
diff --git a/rtl/s390x/s390x.inc b/rtl/s390x/s390x.inc
index 8e523f58..c7d40aad 100644
--- a/rtl/s390x/s390x.inc
+++ b/rtl/s390x/s390x.inc
@@ -22,29 +22,41 @@
                                   FPU
 ****************************************************************************}
 
-{$define FPC_SYSTEM_HAS_SYSINITFPU}
-procedure SysInitFPU;
+{ the floating point control register is accessed in C
+  (zos-pascal-llvm: runtime/zosfpu.c) }
+function zos_get_fpc: dword; cdecl; external name 'FPC_ZOS_GET_FPC';
+procedure zos_set_fpc(v: dword); cdecl; external name 'FPC_ZOS_SET_FPC';
+
+function GetNativeFPUControlWord: TNativeFPUControlWord;{$ifdef SYSTEMINLINE}inline;{$endif}
   begin
-    softfloat_rounding_mode:=rmNearest;
-    softfloat_exception_mask:=[float_flag_underflow,float_flag_inexact,float_flag_denormal];
-    softfloat_exception_flags:=[];
+    result:=zos_get_fpc;
   end;
 
 
-{$define FPC_SYSTEM_HAS_SYSRESETFPU}
-procedure SysResetFPU;{$ifdef SYSTEMINLINE}inline;{$endif}
+procedure SetNativeFPUControlWord(const cw: TNativeFPUControlWord);{$ifdef SYSTEMINLINE}inline;{$endif}
   begin
-    softfloat_exception_flags:=[];
+    zos_set_fpc(cw);
   end;
 
 
-function GetNativeFPUControlWord: TNativeFPUControlWord;{$ifdef SYSTEMINLINE}inline;{$endif}
+{$define FPC_SYSTEM_HAS_SYSINITFPU}
+procedure SysInitFPU;
   begin
+    softfloat_rounding_mode:=rmNearest;
+    softfloat_exception_mask:=[float_flag_underflow,float_flag_inexact,float_flag_denormal];
+    softfloat_exception_flags:=[];
+    { round to nearest, trap on invalid operation, division by zero and
+      overflow (like the other targets) }
+    zos_set_fpc((zos_get_fpc and not (fpc_trap_mask or fpc_flag_mask or fpc_dxc_mask or fpc_round_mask))
+      or fpc_trap_invalid or fpc_trap_zerodiv or fpc_trap_overflow);
   end;
 
 
-procedure SetNativeFPUControlWord(const cw: TNativeFPUControlWord);{$ifdef SYSTEMINLINE}inline;{$endif}
+{$define FPC_SYSTEM_HAS_SYSRESETFPU}
+procedure SysResetFPU;{$ifdef SYSTEMINLINE}inline;{$endif}
   begin
+    softfloat_exception_flags:=[];
+    zos_set_fpc(zos_get_fpc and not (fpc_flag_mask or fpc_dxc_mask));
   end;
 
 
