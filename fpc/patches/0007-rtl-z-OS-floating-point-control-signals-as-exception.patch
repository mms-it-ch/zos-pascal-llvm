-    Signal handler for z/OS: converts synchronous signals into run-time
-    errors. Resuming at HandleErrorAddrFrame through the machine context
-    (as on other targets) is not implemented; the error is reported
-    directly from the signal handler.
+    Signal handler for z/OS: converts signals into run-time errors. As on
+    other targets, the machine context is changed so that the interrupted
+    code continues in HandleErrorAddrFrame (FPC_ZOS_SIGREDIRECT, zossig.c);
+    raising directly in the handler does not work because the unwinder
+    cannot pass the LE signal delivery frames.
 
     See the file COPYING.FPC, included in this distribution,
     for details about the copyright.
@@ -16,6 +17,8 @@
 
  **********************************************************************}
 
+procedure FPC_ZOS_SIGREDIRECT(ucontext, fn: pointer; err: clong); cdecl; external name 'FPC_ZOS_SIGREDIRECT';
+
 procedure SignalToRunerror(Sig: longint; info : PSigInfo; SigContext:PSigContext); public name '_FPC_DEFAULTSIGHANDLER'; cdecl;
 var
   res : word;
@@ -23,7 +26,24 @@ procedure SignalToRunerror(Sig: longint; info : PSigInfo; SigContext:PSigContext
   res:=0;
   case sig of
     SIGFPE:
-      res:=207;
+      begin
+        case info^.si_code of
+          FPE_INTDIV:
+            res:=200;
+          FPE_FLTDIV:
+            res:=208;
+          FPE_FLTOVF:
+            res:=205;
+          FPE_FLTUND:
+            res:=206;
+          FPE_INTOVF:
+            res:=215;
+          else
+            res:=207;
+        end;
+        { the exception flags and the data exception code are cleared in
+          the machine context by FPC_ZOS_SIGREDIRECT }
+      end;
     SIGILL,
     SIGBUS,
     SIGSEGV:
@@ -34,6 +54,6 @@ procedure SignalToRunerror(Sig: longint; info : PSigInfo; SigContext:PSigContext
       res:=233;
   end;
   reenable_signal(sig);
-  if res<>0 then
-    HandleErrorAddrFrame(res,nil,nil);
+  if (res<>0) and assigned(SigContext) then
+    FPC_ZOS_SIGREDIRECT(SigContext,@HandleErrorAddrFrame,res);
 end;
