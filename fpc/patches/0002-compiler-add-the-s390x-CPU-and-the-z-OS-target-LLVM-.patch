diff --git a/compiler/s390x/cpupara.pas b/compiler/s390x/cpupara.pas
new file mode 100644
index 00000000..856f2396
--- /dev/null
+++ b/compiler/s390x/cpupara.pas
@@ -0,0 +1,508 @@
+{
+    Copyright (c) 2026 by the Free Pascal development team
+
+    Calling conventions for s390x on z/OS (XPLINK-64)
+
+    Only the LLVM code generator is supported for s390x. LLVM assigns the
+    actual registers and argument area slots; the parameter manager has to
+    decompose parameters the same way clang does (see ZOSXPLinkABIInfo in
+    clang/lib/CodeGen/Targets/SystemZ.cpp), so that Pascal code and C code
+    can call each other:
+
+      - integers smaller than 64 bits are sign/zero extended to 64 bits
+      - floating point values are passed in FPR 0, 2, 4, 6 (named parameters
+        only, varargs floating point values are passed like integers)
+      - records are passed by value as a sequence of 64 bit integers
+        (records consisting of two floating point fields of the same type
+         as two floating point values)
+      - the first three 64 bit slots are passed in GPR 1-3, the remaining
+        ones in the argument area
+
+    This program is free software; you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation; either version 2 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program; if not, write to the Free Software
+    Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+
+ ****************************************************************************
+}
+unit cpupara;
+
+{$i fpcdefs.inc}
+
+  interface
+
+    uses
+      globtype,
+      aasmdata,
+      symconst,symtype,symdef,
+      cgbase,cgutils,
+      parabase,paramgr;
+
+    type
+      tcpuparamanager = class(tparamanager)
+        function get_volatile_registers_int(calloption: tproccalloption): tcpuregisterset; override;
+        function get_volatile_registers_fpu(calloption: tproccalloption): tcpuregisterset; override;
+        function get_saved_registers_int(calloption: tproccalloption): tcpuregisterarray; override;
+        function get_saved_registers_fpu(calloption: tproccalloption): tcpuregisterarray; override;
+        function push_addr_param(varspez: tvarspez; def: tdef; calloption: tproccalloption): boolean; override;
+        function get_funcretloc(p: tabstractprocdef; side: tcallercallee; forcetempdef: tdef): tcgpara; override;
+        procedure getcgtempparaloc(list: TAsmList; pd: tabstractprocdef; nr: longint; var cgpara: tcgpara); override;
+        function create_paraloc_info(p: tabstractprocdef; side: tcallercallee): longint; override;
+        function create_varargs_paraloc_info(p: tabstractprocdef; side: tcallercallee; varargspara: tvarargsparalist): longint; override;
+      private
+        procedure init_values(out curintreg, curfloatreg: tsuperregister; out cur_stack_offset: aword);
+        function create_paraloc_info_intern(p: tabstractprocdef; side: tcallercallee; paras: tparalist;
+          var curintreg, curfloatreg: tsuperregister; var cur_stack_offset: aword; isvararg: boolean): longint;
+        procedure create_paraloc_for_def(var para: tcgpara; varspez: tvarspez; paradef: tdef;
+          var nextintreg, nextfloatreg: tsuperregister; var stack_offset: aword;
+          isvararg: boolean; side: tcallercallee; p: tabstractprocdef);
+      end;
+
+  implementation
+
+    uses
+      verbose,
+      globals,
+      systems,
+      cpuinfo,
+      symsym,
+      symtable,
+      defutil,
+      cpubase;
+
+    const
+      { GPR 1-3 carry the first three argument slots }
+      last_int_param_reg = RS_R3;
+      { FPR 0, 2, 4, 6 carry the first four floating point arguments }
+      last_float_param_reg = RS_F6;
+
+
+    function tcpuparamanager.get_volatile_registers_int(calloption: tproccalloption): tcpuregisterset;
+      begin
+        result:=[RS_R0..RS_R7];
+      end;
+
+
+    function tcpuparamanager.get_volatile_registers_fpu(calloption: tproccalloption): tcpuregisterset;
+      begin
+        result:=[RS_F0..RS_F7];
+      end;
+
+
+    function tcpuparamanager.get_saved_registers_int(calloption: tproccalloption): tcpuregisterarray;
+      const
+        saved_regs: tcpuregisterarray = (RS_R8,RS_R9,RS_R10,RS_R11,RS_R12,RS_R13,RS_R14,RS_R15);
+      begin
+        result:=saved_regs;
+      end;
+
+
+    function tcpuparamanager.get_saved_registers_fpu(calloption: tproccalloption): tcpuregisterarray;
+      const
+        saved_regs: tcpuregisterarray = (RS_F8,RS_F9,RS_F10,RS_F11,RS_F12,RS_F13,RS_F14,RS_F15);
+      begin
+        result:=saved_regs;
+      end;
+
+
+    function tcpuparamanager.push_addr_param(varspez: tvarspez; def: tdef; calloption: tproccalloption): boolean;
+      begin
+        result:=false;
+        { var,out,constref always require address }
+        if varspez in [vs_var,vs_out,vs_constref] then
+          begin
+            result:=true;
+            exit;
+          end;
+        case def.typ of
+          variantdef,
+          formaldef:
+            result:=true;
+          { "procedure of object" must be interchangeable with a TMethod
+            record, so procvars are treated like records }
+          procvardef,
+          recorddef:
+            { C passes records by value; Pascal passes const records by
+              reference and small value records by value }
+            if calloption in cdecl_pocalls then
+              result:=false
+            else
+              result:=(varspez=vs_const) or not(def.size in [0..3*sizeof(aint)]);
+          arraydef:
+            { C arrays are always passed by reference }
+            result:=(tarraydef(def).highrange>=tarraydef(def).lowrange) or
+                    is_open_array(def) or
+                    is_array_of_const(def) or
+                    is_array_constructor(def);
+          objectdef:
+            result:=is_object(def);
+          setdef:
+            result:=not is_smallset(def);
+          stringdef:
+            result:=tstringdef(def).stringtype in [st_shortstring,st_longstring];
+          else
+            ;
+        end;
+      end;
+
+
+    procedure tcpuparamanager.init_values(out curintreg, curfloatreg: tsuperregister; out cur_stack_offset: aword);
+      begin
+        curintreg:=RS_R1;
+        curfloatreg:=RS_F0;
+        cur_stack_offset:=0;
+      end;
+
+
+    function tcpuparamanager.get_funcretloc(p: tabstractprocdef; side: tcallercallee; forcetempdef: tdef): tcgpara;
+      var
+        paraloc: pcgparalocation;
+        retcgsize: tcgsize;
+      begin
+        if set_common_funcretloc_info(p,forcetempdef,retcgsize,result) then
+          exit;
+        paraloc:=result.add_location;
+        if (result.def.typ=floatdef) then
+          begin
+            paraloc^.loc:=LOC_FPUREGISTER;
+            paraloc^.register:=NR_FPU_RESULT_REG;
+            paraloc^.size:=retcgsize;
+            paraloc^.def:=result.def;
+          end
+        else
+          begin
+            paraloc^.loc:=LOC_REGISTER;
+            paraloc^.register:=NR_FUNCTION_RETURN_REG;
+            { integer results are extended to 64 bits }
+            if is_ordinal(result.def) and (result.def.size<8) then
+              begin
+                if is_signed(result.def) then
+                  begin
+                    paraloc^.size:=OS_S64;
+                    paraloc^.def:=s64inttype;
+                  end
+                else
+                  begin
+                    paraloc^.size:=OS_64;
+                    paraloc^.def:=u64inttype;
+                  end;
+              end
+            else
+              begin
+                paraloc^.size:=retcgsize;
+                paraloc^.def:=result.def;
+              end;
+          end;
+      end;
+
+
+    procedure tcpuparamanager.getcgtempparaloc(list: TAsmList; pd: tabstractprocdef; nr: longint; var cgpara: tcgpara);
+      var
+        paraloc: pcgparalocation;
+        psym: tparavarsym;
+        pdef: tdef;
+      begin
+        psym:=tparavarsym(pd.paras[nr-1]);
+        pdef:=psym.vardef;
+        if push_addr_param(psym.varspez,pdef,pd.proccalloption) then
+          pdef:=cpointerdef.getreusable_no_free(pdef);
+        cgpara.reset;
+        cgpara.size:=def_cgsize(pdef);
+        cgpara.intsize:=tcgsize2size[cgpara.size];
+        cgpara.alignment:=get_para_align(pd.proccalloption);
+        cgpara.def:=pdef;
+        paraloc:=cgpara.add_location;
+        with paraloc^ do
+          begin
+            size:=def_cgsize(pdef);
+            def:=pdef;
+            if nr<=3 then
+              begin
+                loc:=LOC_REGISTER;
+                register:=newreg(R_INTREGISTER,RS_R1+nr-1,R_SUBWHOLE);
+              end
+            else
+              begin
+                loc:=LOC_REFERENCE;
+                reference.index:=NR_STACK_POINTER_REG;
+                reference.offset:=sizeof(pint)*(nr-1);
+              end;
+          end;
+      end;
+
+
+    function tcpuparamanager.create_paraloc_info(p: tabstractprocdef; side: tcallercallee): longint;
+      var
+        cur_stack_offset: aword;
+        curintreg, curfloatreg: tsuperregister;
+      begin
+        init_values(curintreg,curfloatreg,cur_stack_offset);
+        result:=create_paraloc_info_intern(p,side,p.paras,curintreg,curfloatreg,cur_stack_offset,false);
+        create_funcretloc_info(p,side);
+      end;
+
+
+    function tcpuparamanager.create_varargs_paraloc_info(p: tabstractprocdef; side: tcallercallee; varargspara: tvarargsparalist): longint;
+      var
+        cur_stack_offset: aword;
+        curintreg, curfloatreg: tsuperregister;
+      begin
+        init_values(curintreg,curfloatreg,cur_stack_offset);
+        result:=create_paraloc_info_intern(p,side,p.paras,curintreg,curfloatreg,cur_stack_offset,false);
+        if (p.proccalloption in cstylearrayofconst) then
+          begin
+            if assigned(varargspara) then
+              begin
+                if side=callerside then
+                  result:=create_paraloc_info_intern(p,side,varargspara,curintreg,curfloatreg,cur_stack_offset,true)
+                else
+                  internalerror(2026092710);
+              end;
+          end
+        else
+          internalerror(2026092711);
+        create_funcretloc_info(p,side);
+      end;
+
+
+    function tcpuparamanager.create_paraloc_info_intern(p: tabstractprocdef; side: tcallercallee; paras: tparalist;
+      var curintreg, curfloatreg: tsuperregister; var cur_stack_offset: aword; isvararg: boolean): longint;
+      var
+        i: longint;
+        hp: tparavarsym;
+        paraloc: pcgparalocation;
+      begin
+        for i:=0 to paras.count-1 do
+          begin
+            hp:=tparavarsym(paras[i]);
+            if (vo_has_explicit_paraloc in hp.varoptions) then
+              internalerror(2026092712);
+            { C-style array of const: handled by the varargs code }
+            if (p.proccalloption in cstylearrayofconst) and
+               is_array_of_const(hp.vardef) then
+              begin
+                paraloc:=hp.paraloc[side].add_location;
+                { hack: the paraloc must be valid, but is not actually used }
+                paraloc^.loc:=LOC_REGISTER;
+                paraloc^.register:=NR_R1;
+                paraloc^.size:=OS_ADDR;
+                paraloc^.def:=voidpointertype;
+                break;
+              end;
+            create_paraloc_for_def(hp.paraloc[side],hp.varspez,hp.vardef,
+              curintreg,curfloatreg,cur_stack_offset,isvararg,side,p);
+          end;
+        result:=cur_stack_offset;
+      end;
+
+
+    { returns the floating point type if def is a record with exactly two
+      floating point fields of the same type ("complex-like" in XPLINK) }
+    function complex_like_float_type(def: tdef): tdef;
+      var
+        i, count: longint;
+        sym: tsym;
+        fdef: tdef;
+      begin
+        result:=nil;
+        if (def.typ<>recorddef) then
+          exit;
+        count:=0;
+        fdef:=nil;
+        for i:=0 to tabstractrecorddef(def).symtable.symlist.count-1 do
+          begin
+            sym:=tsym(tabstractrecorddef(def).symtable.symlist[i]);
+            if (sym.typ<>fieldvarsym) or
+               (sp_static in sym.symoptions) then
+              continue;
+            inc(count);
+            if (tfieldvarsym(sym).vardef.typ<>floatdef) or
+               (count>2) then
+              exit;
+            if not assigned(fdef) then
+              fdef:=tfieldvarsym(sym).vardef
+            else if tfloatdef(fdef).floattype<>tfloatdef(tfieldvarsym(sym).vardef).floattype then
+              exit;
+          end;
+        if (count=2) and
+           (def.size=2*fdef.size) and
+           (tfloatdef(fdef).floattype in [s32real,s64real]) then
+          result:=fdef;
+      end;
+
+
+    procedure tcpuparamanager.create_paraloc_for_def(var para: tcgpara; varspez: tvarspez; paradef: tdef;
+      var nextintreg, nextfloatreg: tsuperregister; var stack_offset: aword;
+      isvararg: boolean; side: tcallercallee; p: tabstractprocdef);
+
+      procedure add_int_loc(size: tcgsize; def: tdef);
+        var
+          paraloc: pcgparalocation;
+        begin
+          paraloc:=para.add_location;
+          paraloc^.size:=size;
+          paraloc^.def:=def;
+          if nextintreg<=last_int_param_reg then
+            begin
+              paraloc^.loc:=LOC_REGISTER;
+              paraloc^.register:=newreg(R_INTREGISTER,nextintreg,R_SUBWHOLE);
+              inc(nextintreg);
+            end
+          else
+            begin
+              paraloc^.loc:=LOC_REFERENCE;
+              if side=callerside then
+                paraloc^.reference.index:=NR_STACK_POINTER_REG
+              else
+                paraloc^.reference.index:=NR_FRAME_POINTER_REG;
+              paraloc^.reference.offset:=stack_offset;
+            end;
+          inc(stack_offset,8);
+        end;
+
+      procedure add_float_loc(def: tdef);
+        var
+          paraloc: pcgparalocation;
+        begin
+          paraloc:=para.add_location;
+          paraloc^.size:=def_cgsize(def);
+          paraloc^.def:=def;
+          if nextfloatreg<=last_float_param_reg then
+            begin
+              paraloc^.loc:=LOC_FPUREGISTER;
+              paraloc^.register:=newreg(R_FPUREGISTER,nextfloatreg,R_SUBWHOLE);
+              inc(nextfloatreg,2);
+            end
+          else
+            begin
+              paraloc^.loc:=LOC_REFERENCE;
+              if side=callerside then
+                paraloc^.reference.index:=NR_STACK_POINTER_REG
+              else
+                paraloc^.reference.index:=NR_FRAME_POINTER_REG;
+              paraloc^.reference.offset:=stack_offset;
+            end;
+          { a floating point argument occupies an argument slot as well; the
+            corresponding GPR is skipped }
+          if nextintreg<=last_int_param_reg then
+            inc(nextintreg);
+          inc(stack_offset,8);
+        end;
+
+      var
+        paralen: aint;
+        fdef: tdef;
+        paraloc: pcgparalocation;
+      begin
+        para.reset;
+        para.alignment:=std_param_align;
+
+        if push_addr_param(varspez,paradef,p.proccalloption) then
+          begin
+            paradef:=cpointerdef.getreusable_no_free(paradef);
+            para.size:=OS_ADDR;
+            para.intsize:=sizeof(pint);
+            para.def:=paradef;
+            add_int_loc(OS_ADDR,paradef);
+            exit;
+          end;
+
+        if not is_special_array(paradef) then
+          paralen:=paradef.size
+        else
+          paralen:=tcgsize2size[def_cgsize(paradef)];
+        para.def:=paradef;
+        para.intsize:=paralen;
+        para.size:=def_cgsize(paradef);
+
+        { empty records }
+        if (paralen=0) and
+           (paradef.typ=recorddef) then
+          begin
+            paraloc:=para.add_location;
+            paraloc^.loc:=LOC_VOID;
+            exit;
+          end;
+
+        case paradef.typ of
+          floatdef:
+            begin
+              case tfloatdef(paradef).floattype of
+                s32real,s64real:
+                  if isvararg then
+                    { varargs: floating point values are passed like integers }
+                    add_int_loc(OS_64,u64inttype)
+                  else
+                    add_float_loc(paradef);
+                s64currency,s64comp:
+                  add_int_loc(OS_S64,s64inttype);
+                else
+                  internalerror(2026092713);
+              end;
+            end;
+          recorddef,
+          arraydef,
+          setdef,
+          stringdef,
+          procvardef,
+          objectdef,
+          variantdef:
+            begin
+              fdef:=complex_like_float_type(paradef);
+              if assigned(fdef) and not isvararg then
+                begin
+                  add_float_loc(fdef);
+                  add_float_loc(fdef);
+                end
+              else if is_ordinal(paradef) or
+                      (paradef.typ in [procvardef,objectdef,stringdef]) and (paralen=sizeof(pint)) and
+                      not(paradef.typ=procvardef) or
+                      ((paradef.typ=procvardef) and tprocvardef(paradef).is_addressonly) then
+                add_int_loc(OS_ADDR,paradef)
+              else
+                begin
+                  { passed by value as a sequence of 64 bit integers }
+                  para.size:=OS_NO;
+                  while paralen>0 do
+                    begin
+                      add_int_loc(OS_64,u64inttype);
+                      dec(paralen,8);
+                    end;
+                end;
+            end;
+          orddef,
+          enumdef:
+            begin
+              if paralen>8 then
+                begin
+                  { 128 bit integers }
+                  para.size:=OS_NO;
+                  while paralen>0 do
+                    begin
+                      add_int_loc(OS_64,u64inttype);
+                      dec(paralen,8);
+                    end;
+                end
+              else if is_signed(paradef) then
+                add_int_loc(OS_S64,s64inttype)
+              else
+                add_int_loc(OS_64,u64inttype);
+            end;
+          else
+            { pointers, class references, formal parameters, ... }
+            add_int_loc(OS_ADDR,paradef);
+        end;
+      end;
+
+begin
+  paramanager:=tcpuparamanager.create;
+end.
