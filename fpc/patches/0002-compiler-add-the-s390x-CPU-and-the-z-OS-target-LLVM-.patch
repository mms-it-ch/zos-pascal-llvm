+            unitlibext   : '.ppl';
+            asmext       : '.s';
+            objext       : '.o';
+            resext       : '.res';
+            resobjext    : '.or';
+            sharedlibext : '.so';
+            staticlibext : '.a';
+            staticlibprefix : 'libp';
+            sharedlibprefix : 'lib';
+            sharedClibext : '.so';
+            staticClibext : '.a';
+            staticClibprefix : 'lib';
+            sharedClibprefix : 'lib';
+            importlibprefix : 'libimp';
+            importlibext : '.x';
+            Cprefix      : '';
+            newline      : #10;
+            dirsep       : '/';
+            assem        : as_clang_llvm;
+            assemextern  : as_clang_llvm;
+            link         : ld_none;
+            linkextern   : ld_zos;
+            ar           : ar_gnu_ar;
+            res          : res_none;
+            dbg          : dbg_none;
+            script       : script_unix;
+            endian       : endian_big;
+            alignment    :
+              (
+                procalign       : 8;
+                loopalign       : 4;
+                jumpalign       : 0;
+                jumpalignskipmax    : 0;
+                coalescealign   : 0;
+                coalescealignskipmax: 0;
+                constalignmin   : 0;
+                constalignmax   : 8;
+                varalignmin     : 0;
+                varalignmax     : 8;
+                localalignmin   : 4;
+                localalignmax   : 8;
+                recordalignmin  : 0;
+                recordalignmax  : 8;
+                maxCrecordalign : 8
+              );
+            first_parm_offset : 0;
+            stacksize    : 1024*1024;
+            stackalign   : 8;
+            abi : abi_default;
+            { same as clang --target=s390x-ibm-zos }
+            llvmdatalayout : 'E-S64-m:l-p1:32:32-i1:8:16-i8:8:16-i64:64-f128:64-v128:64-a:8:16-n32:64';
+          );
+
+  implementation
+
+initialization
+{$ifdef CPUS390X}
+  {$ifdef zos}
+    set_source_info(system_s390x_zos_info);
+  {$endif zos}
+{$endif CPUS390X}
+end.
diff --git a/compiler/systems/t_zos.pas b/compiler/systems/t_zos.pas
new file mode 100644
index 00000000..6481bddc
--- /dev/null
+++ b/compiler/systems/t_zos.pas
@@ -0,0 +1,183 @@
+{
+    Copyright (c) 2026 by the Free Pascal development team
+
+    This unit implements support import, export, link routines
+    for the z/OS target
+
+    Programs are bound on z/OS itself (z/OS UNIX ld, i.e. the binder). The
+    linker below writes a link list (<program>.zlink) with the object
+    files and libraries and hands it to an external tool (zos-ld by
+    default, see -XP / -FD) that transfers the files and runs the binder.
+
+    This program is free software; you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation; either version 2 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program; if not, write to the Free Software
+    Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+
+ ****************************************************************************
+}
+unit t_zos;
+
+{$i fpcdefs.inc}
+
+interface
+
+  uses
+    globtype,link,
+    import,export,expunix;
+
+  type
+    timportlibzos=class(timportlib)
+      procedure generatelib;override;
+    end;
+
+    texportlibzos=class(texportlibunix)
+    end;
+    TLinkerZOS=class(texternallinker)
+    private
+      function WriteLinkList(const fn: TCmdStr; isdll: boolean): boolean;
+      function CallLinker(isdll: boolean): boolean;
+    public
+      procedure SetDefaultInfo;override;
+      function  MakeExecutable:boolean;override;
+      function  MakeSharedLibrary:boolean;override;
+    end;
+
+implementation
+
+  uses
+    SysUtils,
+    cutils,cfileutl,cclasses,
+    verbose,systems,globals,
+    fmodule,ogbase,
+    i_zos;
+
+{*****************************************************************************
+                               timportlibzos
+*****************************************************************************}
+
+    procedure timportlibzos.generatelib;
+      var
+        i: longint;
+        ImportLibrary: TImportLibrary;
+      begin
+        for i:=0 to current_module.ImportLibraryList.Count-1 do
+          begin
+            ImportLibrary:=TImportLibrary(current_module.ImportLibraryList[i]);
+            current_module.linkothersharedlibs.add(ImportLibrary.Name,link_always);
+          end;
+      end;
+
+
+{*****************************************************************************
+                                  TLinkerZOS
+*****************************************************************************}
+
+    procedure TLinkerZOS.SetDefaultInfo;
+      begin
+        with Info do
+          begin
+            { zos-ld <kind> <output> <link list> }
+            ExeCmd[1]:='zos-ld exe $EXE $RES';
+            DllCmd[1]:='zos-ld dll $EXE $RES';
+            ResName:='link.zlink';
+          end;
+      end;
+
+
+    function TLinkerZOS.WriteLinkList(const fn: TCmdStr; isdll: boolean): boolean;
+      var
+        t: text;
+        s: TCmdStr;
+      begin
+        assign(t,fn);
+        {$push}{$i-}
+        rewrite(t);
+        {$pop}
+        if ioresult<>0 then
+          begin
+            result:=false;
+            exit;
+          end;
+        { object files, in link order }
+        while not ObjectFiles.Empty do
+          begin
+            s:=ObjectFiles.GetFirst;
+            if s<>'' then
+              writeln(t,'obj ',s);
+          end;
+        { Pascal static libraries }
+        while not StaticLibFiles.Empty do
+          begin
+            s:=StaticLibFiles.GetFirst;
+            if s<>'' then
+              writeln(t,'lib ',s);
+          end;
+        { C libraries (linklib directive); the C runtime itself comes from LE }
+        while not SharedLibFiles.Empty do
+          begin
+            s:=SharedLibFiles.GetFirst;
+            if (s<>'') and (s<>'c') then
+              writeln(t,'clib ',s);
+          end;
+        if isdll then
+          writeln(t,'dll');
+        close(t);
+        result:=true;
+      end;
+
+
+    function TLinkerZOS.CallLinker(isdll: boolean): boolean;
+      var
+        binstr, cmdstr, resname: TCmdStr;
+      begin
+        resname:=outputexedir+ChangeFileExt(ExtractFileName(current_module.exefilename),'.zlink');
+        result:=WriteLinkList(resname,isdll);
+        if not result then
+          exit;
+        if isdll then
+          SplitBinCmd(Info.DllCmd[1],binstr,cmdstr)
+        else
+          SplitBinCmd(Info.ExeCmd[1],binstr,cmdstr);
+        Replace(cmdstr,'$EXE',maybequoted(current_module.exefilename));
+        Replace(cmdstr,'$RES',maybequoted(resname));
+        binstr:=FindUtil(utilsprefix+binstr);
+        result:=DoExec(binstr,cmdstr,true,false);
+      end;
+
+
+    function TLinkerZOS.MakeExecutable:boolean;
+      begin
+        if not(cs_link_nolink in current_settings.globalswitches) then
+          Message1(exec_i_linking,current_module.exefilename);
+        result:=CallLinker(false);
+      end;
+
+
+    function TLinkerZOS.MakeSharedLibrary:boolean;
+      begin
+        if not(cs_link_nolink in current_settings.globalswitches) then
+          Message1(exec_i_linking,current_module.sharedlibfilename);
+        result:=CallLinker(true);
+      end;
+
+
+{*****************************************************************************
+                                     Initialize
+*****************************************************************************}
+
+initialization
+  RegisterLinker(ld_zos,TLinkerZOS);
+  RegisterImport(system_s390x_zos,timportlibzos);
+  RegisterExport(system_s390x_zos,texportlibzos);
+  RegisterTarget(system_s390x_zos_info);
+end.
