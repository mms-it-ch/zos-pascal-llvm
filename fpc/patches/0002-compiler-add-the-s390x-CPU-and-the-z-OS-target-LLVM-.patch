index 00000000..a10eff30
--- /dev/null
+++ b/compiler/s390x/s390xreg.dat
@@ -0,0 +1,41 @@
+;
+;  s390x (z/Architecture) registers
+;
+;  layout
+;  <name>,<type>,<subtype>,<value>,<stdname>,<stab idx>,<dwarf idx>
+;
+NO,$00,$00,$00,INVALID,-1,-1
+; General purpose registers
+R0,$01,$00,$00,r0,0,0
+R1,$01,$00,$01,r1,1,1
+R2,$01,$00,$02,r2,2,2
+R3,$01,$00,$03,r3,3,3
+R4,$01,$00,$04,r4,4,4
+R5,$01,$00,$05,r5,5,5
+R6,$01,$00,$06,r6,6,6
+R7,$01,$00,$07,r7,7,7
+R8,$01,$00,$08,r8,8,8
+R9,$01,$00,$09,r9,9,9
+R10,$01,$00,$0a,r10,10,10
+R11,$01,$00,$0b,r11,11,11
+R12,$01,$00,$0c,r12,12,12
+R13,$01,$00,$0d,r13,13,13
+R14,$01,$00,$0e,r14,14,14
+R15,$01,$00,$0f,r15,15,15
+; Floating point registers (DWARF numbering of the s390x ELF ABI)
+F0,$02,$00,$00,f0,16,16
+F1,$02,$00,$01,f1,20,20
+F2,$02,$00,$02,f2,17,17
+F3,$02,$00,$03,f3,21,21
+F4,$02,$00,$04,f4,18,18
