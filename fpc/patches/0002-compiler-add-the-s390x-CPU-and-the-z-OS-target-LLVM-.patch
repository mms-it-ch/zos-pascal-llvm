+F7,$02,$00,$07,f7,23,23
+F8,$02,$00,$08,f8,24,24
+F9,$02,$00,$09,f9,28,28
+F10,$02,$00,$0a,f10,25,25
+F11,$02,$00,$0b,f11,29,29
+F12,$02,$00,$0c,f12,26,26
+F13,$02,$00,$0d,f13,30,30
+F14,$02,$00,$0e,f14,27,27
+F15,$02,$00,$0f,f15,31,31
