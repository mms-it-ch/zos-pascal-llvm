+              )
+            );
+            tcb.free;
+            tcb := nil;
+          end;
       end;
 
     procedure Tresourcestrings.WriteRSJFile;
diff --git a/compiler/llvm/agllvm.pas b/compiler/llvm/agllvm.pas
index 033cb1d7..3cd0e37c 100644
--- a/compiler/llvm/agllvm.pas
+++ b/compiler/llvm/agllvm.pas
@@ -561,6 +561,38 @@        tdoubleval = record
      end;
 
 
+  { z/OS: the landing pad of a try..except block only has catch clauses for
+    its own exception classes; if none matches, the code in the landing pad
+    re-raises the exception. The phase 1 search of the unwinder however
+    skips a landing pad whose clauses do not match, so an enclosing handler
+    in the same function would never be found. Add a catch-all clause at
+    the end, so that the landing pad is always entered and can re-raise. }
+  procedure add_catch_all_to_typed_landingpad(lp: taillvm);
+    var
+      clause: taillvm;
+      typed, catchall: boolean;
+    begin
+      typed:=false;
+      catchall:=false;
+      if lp.ops<3 then
+        exit;
+      clause:=taillvm(lp.oper[2]^.ai);
+      while assigned(clause) do
+        begin
+          { cleanup clauses have no operands and are always the last one }
+          if clause.llvmopcode<>la_catch then
+            exit;
+          if assigned(clause.oper[1]^.ref^.symbol) then
+            typed:=true
+          else
+            catchall:=true;
+          clause:=taillvm(clause.oper[2]^.ai);
+        end;
+      if typed and not catchall then
+        lp.landingpad_add_clause(la_catch,voidpointertype,nil);
+    end;
+
+
   procedure TLLVMInstrWriter.WriteInstruction(hp: tai);
     var
       op: tllvmop;
@@ -572,6 +604,9 @@        tdoubleval = record
       done: boolean;
     begin
       op:=taillvm(hp).llvmopcode;
+      if (op=la_landingpad) and
+         (target_info.system=system_s390x_zos) then
+        add_catch_all_to_typed_landingpad(taillvm(hp));
       { we write everything immediately rather than adding it into a string,
         because operands may contain other tai that will also write things out
         (and their output must come after everything that was processed in this
diff --git a/compiler/ngenutil.pas b/compiler/ngenutil.pas
index fc382ee2..56c17775 100644
--- a/compiler/ngenutil.pas
+++ b/compiler/ngenutil.pas
