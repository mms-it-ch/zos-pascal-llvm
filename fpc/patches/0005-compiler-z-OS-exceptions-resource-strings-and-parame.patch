+              tcb.emit_tai(Tai_const.Create_sym(
+                current_asmdata.RefAsmSymbol(make_mangledname('RESSTR',hp.localsymtable,'PTRLIST'),AT_DATA)),
+                voidpointertype);
+              tcb.emit_tai(Tai_const.Create_sym(
+                current_asmdata.RefAsmSymbol(make_mangledname('RESSTR',hp.localsymtable,'PTRLIST'),AT_DATA)),
+                voidpointertype);
+              inc(count);
+            end
+          else if mf_has_resourcestrings in hp.moduleflags then
             begin
               tcb.emit_tai(Tai_const.Create_sym(
                 ctai_typedconstbuilder.get_vectorized_dead_strip_section_symbol_start('RESSTR',hp.localsymtable,[tcdssso_register_asmsym,tcdssso_use_indirect])),
diff --git a/compiler/s390x/cpubase.pas b/compiler/s390x/cpubase.pas
index 857c6a71..585a6ae7 100644
--- a/compiler/s390x/cpubase.pas
+++ b/compiler/s390x/cpubase.pas
@@ -333,8 +333,10 @@ implementation
 
     function eh_return_data_regno(nr: longint): longint;
       begin
+        { XPLINK-64: the landing pad receives the exception object in R1
+          and the selector in R2 (the unwinder uses GPR numbers) }
         if (nr>=0) and (nr<2) then
-          result:=nr+6
+          result:=nr+1
         else
           result:=-1;
       end;
