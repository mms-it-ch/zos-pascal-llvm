+        if target_info.system=system_s390x_zos then
+          begin
+            tcb:=ctai_typedconstbuilder.create([tcalo_is_public_asm,tcalo_new_section]);
+            tcb.begin_anonymous_record('',default_settings.packrecords,sizeof(pint),
+              targetinfos[target_info.system]^.alignment.recordalignmin);
+            count:=0;
+            R:=TResourceStringItem(List.First);
+            while assigned(R) do
+              begin
+                inc(count);
+                R:=TResourceStringItem(R.Next);
+              end;
+            tcb.emit_ord_const(count,sizesinttype);
+            tcb.emit_tai(Tai_const.Create_sym(
+              ctai_typedconstbuilder.get_vectorized_dead_strip_section_symbol_start('RESSTR',current_module.localsymtable,[])),
+              voidpointertype);
+            R:=TResourceStringItem(List.First);
+            while assigned(R) do
+              begin
+                tcb.emit_tai(Tai_const.Create_sym(
+                  current_asmdata.RefAsmSymbol(make_mangledname('RESSTR',R.Sym.Owner,R.Sym.Name),AT_DATA)),
+                  voidpointertype);
+                R:=TResourceStringItem(R.Next);
+              end;
+            resstrdef:=tcb.end_anonymous_record;
+            current_asmdata.AsmLists[al_resourcestrings].concatList(
+              tcb.get_final_asmlist(
+                current_asmdata.DefineAsmSymbol(make_mangledname('RESSTR',current_module.localsymtable,'PTRLIST'),AB_GLOBAL,AT_DATA,resstrdef),
