From 9a1914e6fbd4de5da5c966d1a0076e97e008a613 Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Sun, 27 Sep 2026 20:41:30 +0200
Subject: [PATCH 4/7] compiler: big endian bitpacked int64 constants; capturer
 with nested routines

- typed constants of bitpacked records, big endian: a field of AIntBits
  bits (e.g. an int64 on a 64 bit CPU) was dropped (tw36156)
- LLVM/JVM (parentfpstruct): a routine with a capturer for anonymous
  functions and nested routines kept the capturer in its own local, while
  the nested routines accessed it through the parentfpstruct, which was
  never set: their accesses are only type checked when their code is
  generated, after the parent. Move the capturer and its keep-alive
  variable to the parentfpstruct before the parent is generated
  (tfuncref26, tfuncref48)

Assisted-by: Claude Code (Anthropic)
---
 compiler/ngtcon.pas      |  6 ++++--
 compiler/procdefutil.pas |  7 +++++--
 compiler/psub.pas        | 32 ++++++++++++++++++++++++++++++++
 3 files changed, 41 insertions(+), 4 deletions(-)

diff --git a/compiler/ngtcon.pas b/compiler/ngtcon.pas
index 76c5bd9d..fdf07bc2 100644
--- a/compiler/ngtcon.pas
+++ b/compiler/ngtcon.pas
@@ -365,8 +365,10 @@ function get_next_varsym(def: tabstractrecorddef; const SymList:TFPHashObjectLis
       begin
         if (target_info.endian=endian_big) then
           begin
-            { bitpacked format: left-aligned (i.e., "big endian bitness") }
-            if (bp.packedbitsize<AIntBits) and
+            { bitpacked format: left-aligned (i.e., "big endian bitness");
+              a field of AIntBits bits (e.g. an int64 on a 64 bit CPU) must be
+              stored as well (shiftleft by 0 keeps the value) }
+            if (bp.packedbitsize<=AIntBits) and
                (bp.curbitoffset<AIntBits) then
               bp.curval:=bp.curval or (shiftleft(value,AIntBits-bp.packedbitsize) shr bp.curbitoffset);
             shiftcount:=((AIntBits-bp.packedbitsize)-bp.curbitoffset);
diff --git a/compiler/procdefutil.pas b/compiler/procdefutil.pas
index 866c4bc2..8fa9f16c 100644
--- a/compiler/procdefutil.pas
+++ b/compiler/procdefutil.pas
@@ -27,7 +27,7 @@ interface
 
 uses
   globtype,procinfo,
-  symconst,symtype,symdef,
+  symconst,symtype,symdef,symsym,
   node,nbas;
 
 { create a nested procdef that will be used to outline code from a procedure;
@@ -46,6 +46,9 @@ function capturer_add_procvar_or_proc(owner:tprocinfo;n:tnode;out capturer:tsym;
 procedure initialize_capturer(ctx:tprocinfo;var stmt:tstatementnode);
 procedure postprocess_capturer(ctx:tprocinfo);
 procedure convert_captured_syms(pd:tprocdef;tree:tnode);
+{ the capturer variable of pd and the variable keeping it alive }
+function get_capturer(pd:tprocdef):tabstractvarsym;
+function get_capturer_alive(pd:tprocdef):tabstractvarsym;
 
 implementation
 
@@ -55,7 +58,7 @@ implementation
     pass_1,
     nobj,ncal,nmem,nld,nutils,
     ngenutil,
-    symbase,symsym,symtable,defutil,defcmp,
+    symbase,symtable,defutil,defcmp,
     htypechk,
     pparautl,psub;
 
diff --git a/compiler/psub.pas b/compiler/psub.pas
index 9e2ffaa4..bda01a49 100644
--- a/compiler/psub.pas
+++ b/compiler/psub.pas
@@ -53,6 +53,7 @@         ttempinfo_flags_entry = record
         procedure setup_tempgen;
         procedure TransformNodeTree;
         procedure convert_captured_syms;
+        procedure move_capturer_to_parentfpstruct;
       protected
         procedure generate_code_exceptfilters;
       public
@@ -1767,10 +1768,41 @@ implementation
         { convert the captured symbols for this routine }
         if assigned(code) then
           procdefutil.convert_captured_syms(procdef,code);
+        move_capturer_to_parentfpstruct;
         current_procinfo:=old_current_procinfo;
       end;
 
 
+    procedure tcgprocinfo.move_capturer_to_parentfpstruct;
+{$if defined(llvm) or defined(jvm)}
+      var
+        sym: tabstractvarsym;
+{$endif}
+      begin
+{$if defined(llvm) or defined(jvm)}
+        { these targets pass the locals accessed by nested routines in a
+          parentfpstruct. The nested routines access the capturer through it,
+          but their accesses are only type checked when their code is
+          generated, which is after the code of this routine. So move the
+          capturer (and its keep-alive variable) there now; the loads in this
+          routine are redirected in tcgnestloadnode.pass_1. Otherwise this
+          routine keeps the capturer in its own local, while the nested
+          routines read the never set field of the parentfpstruct. }
+        if not procdef.has_capturer or
+           not assigned(get_first_nestedproc) then
+          exit;
+        if not assigned(procdef.parentfpstruct) then
+          build_parentfpstruct(procdef);
+        sym:=procdefutil.get_capturer(procdef);
+        if assigned(sym) and (sym.owner=procdef.localst) then
+          maybe_add_sym_to_parentfpstruct(procdef,sym,sym.vardef,false);
+        sym:=procdefutil.get_capturer_alive(procdef);
+        if assigned(sym) and (sym.owner=procdef.localst) then
+          maybe_add_sym_to_parentfpstruct(procdef,sym,sym.vardef,false);
+{$endif llvm or jvm}
+      end;
+
+
      procedure TCGProcinfo.CreateInlineInfo;
        begin
         new(procdef.inlininginfo);
