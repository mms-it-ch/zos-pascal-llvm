From 9df7b346d24fed2899c66b3bacb4fc4704a05a9c Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Sun, 27 Sep 2026 20:20:42 +0200
Subject: [PATCH 3/7] compiler: fixes for internally generated code
 (call-through, interface wrappers)

- call-through of external redirects (main stub on z/OS/Darwin/AIX, forward
  declared routines implemented as external): don't prefix the call with
  the program/unit name, which can be hidden by a same-named identifier
  ("program test; var test: integer;", tw11619, tw37322); the redirect
  name is unique anyway
- the name of the redirect is a valid identifier even if the external name
  is not (external name '?Dummy', uw20456)
- high-level interface wrappers (LLVM): mark them internal (no "local
  procedure is not used" hint, tw39736), and call a method of a parent
  class via a typecast of self, so that a same-named method of the
  implementing class is not taken (tw9306a, tw9306b)

Assisted-by: Claude Code (Anthropic)
---
 compiler/ncgvmt.pas   |  3 +++
 compiler/symcreat.pas | 40 +++++++++++++++++++++++++++++++++++++---
 2 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/compiler/ncgvmt.pas b/compiler/ncgvmt.pas
index 1ab4dbee..702db7bf 100644
--- a/compiler/ncgvmt.pas
+++ b/compiler/ncgvmt.pas
@@ -1303,6 +1303,9 @@                         classindex:=classtablelist.IndexOf(tfieldvarsym(sym).var
                         current_module.localsymtable,_class,
                         tsk_interface_wrapper,wrapperinfo);
                       include(wrapperpd.implprocoptions,pio_thunk);
+                      { only referenced from the interface vtable: no
+                        "local procedure is not used" hint }
+                      include(wrapperpd.procsym.symoptions,sp_internal);
                     end
                   else
                     begin
diff --git a/compiler/symcreat.pas b/compiler/symcreat.pas
index 39a096c3..036cdf20 100644
--- a/compiler/symcreat.pas
+++ b/compiler/symcreat.pas
@@ -594,8 +594,13 @@       if (struct.typ=recorddef) and
         str:=str+'result:=';
       { if the routine is a global routine in a unit/program, explicitly
         mnetion this program/unit name to avoid accidentally calling other
-        same-named routines that may be in scope }
-      str:=str+def_unit_name_prefix_if_toplevel(callpd)+callpd.procsym.realname+'(';
+        same-named routines that may be in scope; not needed for the
+        external redirects created by call_through_new_name, whose names are
+        unique, and it would fail if the program/unit name is hidden by a
+        same-named identifier (e.g. "program test; var test: integer;") }
+      if pos('__FPC_IMPL_EXTERNAL_REDIRECT_',callpd.procsym.realname)<>1 then
+        str:=str+def_unit_name_prefix_if_toplevel(callpd);
+      str:=str+callpd.procsym.realname+'(';
       addvisibleparameters(str,pd);
       str:=str+') end;';
       str_parse_method_impl(str,pd,isclassmethod);
@@ -1176,6 +1181,19 @@       if (struct.typ=recorddef) and
       { now call through to the actual method }
       if pd.returndef<>voidtype then
         str:=str+'result:=';
+      { if the method is declared in a parent class, call it via a typecast
+        of self to that class: a same-named method of the implementing class
+        with other parameters or result type would be found first otherwise
+        (e.g. IIntf.Foo: string implemented by TIntf.Foo, and IIntf2.Foo:
+        Integer by TIntf2.Foo, tw9306a) }
+      if (callthroughpd.struct<>pd.struct) and
+         is_class(callthroughpd.struct) and
+         assigned(callthroughpd.struct.typesym) and
+         not(df_generic in callthroughpd.struct.defoptions) and
+         not(df_specialization in callthroughpd.struct.defoptions) and
+         not assigned(callthroughpd.struct.owner.defowner) then
+        str:=str+def_unit_name_prefix_if_toplevel(callthroughpd.struct)+
+          '&'+callthroughpd.struct.typesym.realname+'(self).';
       str:=str+'&'+callthroughpd.procsym.realname+'(';
       addvisibleparameters(str,pd);
       str:=str+') end;';
@@ -2158,6 +2176,22 @@                       if parasym.vardef.typ=classrefdef then
 
 
   procedure call_through_new_name(orgpd: tprocdef; const newname: TSymStr);
+
+    { the redirect is called from internally generated source code, so its
+      name must be a valid identifier even if the external name is not
+      (e.g. external name '?Dummy'): encode other characters as _xx }
+    function redirect_name: TSymStr;
+      var
+        i: longint;
+      begin
+        result:='__FPC_IMPL_EXTERNAL_REDIRECT_';
+        for i:=1 to length(newname) do
+          if newname[i] in ['A'..'Z','a'..'z','0'..'9','_'] then
+            result:=result+newname[i]
+          else
+            result:=result+'_'+hexstr(ord(newname[i]),2);
+      end;
+
     var
       newpd: tprocdef;
     begin
@@ -2182,7 +2216,7 @@                       if parasym.vardef.typ=classrefdef then
       stringdispose(orgpd.import_dll);
       orgpd.import_nr:=0;
       newpd.setmangledname(newname);
-      finish_copied_procdef(newpd,'__FPC_IMPL_EXTERNAL_REDIRECT_'+newname,current_module.localsymtable,nil);
+      finish_copied_procdef(newpd,redirect_name,current_module.localsymtable,nil);
       newpd.forwarddef:=false;
       { ideally we would prefix the parameters of the original routine here, but since it
         can be an interface definition, we cannot do that without risking to change the
-- 
