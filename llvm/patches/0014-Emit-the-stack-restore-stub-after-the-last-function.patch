From eb376521b5fce8c9f4abfb1fd68d3f06d29de13e Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Thu, 12 Nov 2026 18:04:49 +0100
Subject: [PATCH] Emit the stack restore stub after the last function

Address review comments: the first stack restore creates the stub label,
and the stub is emitted after the last function, in doFinalization (with
--generate-arange-section the debug information ends the code section
before emitEndOfAsmFile). Move the stub symbol to the other members, and
keep the backchain handling for ELF only.

Assisted-by: Claude Code (Anthropic)
(cherry picked from commit 4b830bd2d7c742bba2a51fa80612b6db5f6b7346)
---
 llvm/lib/Target/SystemZ/SystemZAsmPrinter.cpp | 22 +++++-----
 llvm/lib/Target/SystemZ/SystemZAsmPrinter.h   |  8 ++--
 .../Target/SystemZ/SystemZISelLowering.cpp    | 28 +++++++------
 .../CodeGen/SystemZ/zos-stackrestore-debug.ll | 34 ++++++++++++++++
 llvm/test/CodeGen/SystemZ/zos-stackrestore.ll | 40 ++++++++++---------
 5 files changed, 85 insertions(+), 47 deletions(-)
 create mode 100644 llvm/test/CodeGen/SystemZ/zos-stackrestore-debug.ll

diff --git a/llvm/lib/Target/SystemZ/SystemZAsmPrinter.cpp b/llvm/lib/Target/SystemZ/SystemZAsmPrinter.cpp
index fc1849b995..073c79c488 100644
--- a/llvm/lib/Target/SystemZ/SystemZAsmPrinter.cpp
+++ b/llvm/lib/Target/SystemZ/SystemZAsmPrinter.cpp
@@ -25,7 +25,6 @@
 #include "llvm/CodeGen/MachineModuleInfoImpls.h"
 #include "llvm/CodeGen/TargetLoweringObjectFileImpl.h"
 #include "llvm/IR/GlobalVariable.h"
-#include "llvm/IR/Intrinsics.h"
 #include "llvm/IR/Mangler.h"
 #include "llvm/IR/Module.h"
 #include "llvm/MC/MCDirectives.h"
@@ -371,7 +370,7 @@ void SystemZAsmPrinter::emitInstruction(const MachineInstr *MI) {
 
   case SystemZ::XPLINK_STACKRESTORE: {
     if (!StackRestoreStub)
-      report_fatal_error("stack restore without llvm.stackrestore in module");
+      StackRestoreStub = OutContext.createTempSymbol("stackrestore");
     EmitToStreamer(*OutStreamer, MCInstBuilder(SystemZ::LARL)
                                      .addReg(SystemZ::R3D)
                                      .addExpr(MCSymbolRefExpr::create(
@@ -1308,6 +1307,15 @@ bool SystemZAsmPrinter::PrintAsmMemoryOperand(const MachineInstr *MI,
   return false;
 }
 
+bool SystemZAsmPrinter::doFinalization(Module &M) {
+  // The stack restore stub follows the last function. It must be emitted
+  // before the debug information is finalized, which may end the code section
+  // (emitEndOfAsmFile is too late).
+  if (StackRestoreStub)
+    emitStackRestoreStub();
+  return AsmPrinter::doFinalization(M);
+}
+
 void SystemZAsmPrinter::emitEndOfAsmFile(Module &M) {
   auto TT = OutContext.getTargetTriple();
   if (TT.isOSzOS()) {
@@ -1732,15 +1740,6 @@ void SystemZAsmPrinter::calculatePPA1() {
 void SystemZAsmPrinter::emitStartOfAsmFile(Module &M) {
   if (TM.getTargetTriple().isOSzOS()) {
     emitPPA2(M);
-    // The stack restore stub is emitted at the start of the file, because the
-    // text section may already be closed at the end (e.g. after emitting the
-    // DWARF aranges). It is needed by every function that uses
-    // llvm.stackrestore.
-    for (const Function &F : M)
-      if (F.getIntrinsicID() == Intrinsic::stackrestore && !F.use_empty()) {
-        emitStackRestoreStub();
-        break;
-      }
   }
   AsmPrinter::emitStartOfAsmFile(M);
 }
@@ -1773,7 +1772,6 @@ void SystemZAsmPrinter::emitStackRestoreStub() {
   OutStreamer->emitIntValueInHex(0x00C300C500C500, 7);
   OutStreamer->AddComment("Mark Type C'4'");
   OutStreamer->emitInt8(0xF4);
-  StackRestoreStub = OutContext.createTempSymbol("stackrestore");
   OutStreamer->emitLabel(StackRestoreStub);
 
   SystemZXPLINK64Registers Regs;
diff --git a/llvm/lib/Target/SystemZ/SystemZAsmPrinter.h b/llvm/lib/Target/SystemZ/SystemZAsmPrinter.h
index 44afa99265..9390ac0acf 100644
--- a/llvm/lib/Target/SystemZ/SystemZAsmPrinter.h
+++ b/llvm/lib/Target/SystemZ/SystemZAsmPrinter.h
@@ -96,6 +96,10 @@ private:
   DenseMap<const GlobalObject *, SmallVector<const GlobalAlias *, 1>>
       GOAliasMap;
 
+  /// Entry of the stack restore stub. Created by the first stack restore of
+  /// the module; the stub is then emitted after the last function.
+  MCSymbol *StackRestoreStub = nullptr;
+
   void calculatePPA1();
   void emitPPA2(Module &M);
   void emitADASection();
@@ -103,9 +107,6 @@ private:
   void emitCELQMAIN(const Function &MainFn);
   void emitStackRestoreStub();
 
-  /// Entry of the stack restore stub, if the module uses llvm.stackrestore.
-  MCSymbol *StackRestoreStub = nullptr;
-
 public:
   SystemZAsmPrinter(TargetMachine &TM, std::unique_ptr<MCStreamer> Streamer)
       : AsmPrinter(TM, std::move(Streamer), ID),
@@ -118,6 +119,7 @@ public:
   void emitXXStructorList(const DataLayout &DL, const Constant *List,
                           bool IsCtor) override;
   void emitEndOfAsmFile(Module &M) override;
+  bool doFinalization(Module &M) override;
   bool PrintAsmOperand(const MachineInstr *MI, unsigned OpNo,
                        const char *ExtraCode, raw_ostream &OS) override;
   bool PrintAsmMemoryOperand(const MachineInstr *MI, unsigned OpNo,
diff --git a/llvm/lib/Target/SystemZ/SystemZISelLowering.cpp b/llvm/lib/Target/SystemZ/SystemZISelLowering.cpp
index e26367d058..df661bccc8 100644
--- a/llvm/lib/Target/SystemZ/SystemZISelLowering.cpp
+++ b/llvm/lib/Target/SystemZ/SystemZISelLowering.cpp
@@ -5390,7 +5390,6 @@ SDValue SystemZTargetLowering::lowerSTACKRESTORE(SDValue Op,
                                                  SelectionDAG &DAG) const {
   MachineFunction &MF = DAG.getMachineFunction();
   auto *Regs = Subtarget.getSpecialRegisters();
-  bool StoreBackchain = MF.getSubtarget<SystemZSubtarget>().hasBackChain();
 
   if (MF.getFunction().getCallingConv() == CallingConv::GHC)
     report_fatal_error("Variable-sized stack allocations are not supported "
@@ -5398,16 +5397,8 @@ SDValue SystemZTargetLowering::lowerSTACKRESTORE(SDValue Op,
 
   SDValue Chain = Op.getOperand(0);
   SDValue NewSP = Op.getOperand(1);
-  SDValue Backchain;
   SDLoc DL(Op);
 
-  if (StoreBackchain) {
-    SDValue OldSP = DAG.getCopyFromReg(
-        Chain, DL, Regs->getStackPointerRegister(), MVT::i64);
-    Backchain = DAG.getLoad(MVT::i64, DL, Chain, getBackchainAddress(OldSP, DAG),
-                            MachinePointerInfo());
-  }
-
   // XPLINK: @@ALCAXP (lowerDYNAMIC_STACKALLOC_XPLINK) moves the frame header
   // (register save area and reserved words at SP + bias) down with the stack
   // pointer, and calls made while the stack pointer is lowered place their
@@ -5421,10 +5412,21 @@ SDValue SystemZTargetLowering::lowerSTACKRESTORE(SDValue Op,
     SDValue Glue;
     Chain = DAG.getCopyToReg(Chain, DL, SystemZ::R1D, NewSP, Glue);
     Glue = Chain.getValue(1);
-    Chain = DAG.getNode(SystemZISD::XPLINK_STACKRESTORE, DL, MVT::Other, Chain,
-                        Glue);
-  } else
-    Chain = DAG.getCopyToReg(Chain, DL, Regs->getStackPointerRegister(), NewSP);
+    return DAG.getNode(SystemZISD::XPLINK_STACKRESTORE, DL, MVT::Other, Chain,
+                       Glue);
+  }
+
+  bool StoreBackchain = MF.getSubtarget<SystemZSubtarget>().hasBackChain();
+  SDValue Backchain;
+  if (StoreBackchain) {
+    SDValue OldSP = DAG.getCopyFromReg(
+        Chain, DL, Regs->getStackPointerRegister(), MVT::i64);
+    Backchain =
+        DAG.getLoad(MVT::i64, DL, Chain, getBackchainAddress(OldSP, DAG),
+                    MachinePointerInfo());
+  }
+
+  Chain = DAG.getCopyToReg(Chain, DL, Regs->getStackPointerRegister(), NewSP);
 
   if (StoreBackchain)
     Chain = DAG.getStore(Chain, DL, Backchain, getBackchainAddress(NewSP, DAG),
diff --git a/llvm/test/CodeGen/SystemZ/zos-stackrestore-debug.ll b/llvm/test/CodeGen/SystemZ/zos-stackrestore-debug.ll
new file mode 100644
index 0000000000..8876f6f7ad
--- /dev/null
+++ b/llvm/test/CodeGen/SystemZ/zos-stackrestore-debug.ll
@@ -0,0 +1,34 @@
+; RUN: llc < %s -mtriple=s390x-ibm-zos --generate-arange-section | FileCheck %s
+; RUN: llc < %s -mtriple=s390x-ibm-zos --generate-arange-section \
+; RUN:   -filetype=obj -o /dev/null
+;
+; The stack restore stub follows the last function. With debug information,
+; it must be emitted before the code section is ended for the address ranges.
+
+; CHECK-LABEL: f DS 0H
+; CHECK:       larl 3,[[STUB:L#stackrestore[0-9]+]]
+; CHECK:      * XPLINK Stub Entry Marker
+; CHECK:      [[STUB]] DS 0H
+; CHECK:       b 2(3)
+
+declare void @use(ptr)
+
+define void @f(i64 %n) !dbg !4 {
+  %sp = call ptr @llvm.stacksave.p0(), !dbg !7
+  %p = alloca i8, i64 %n, align 8, !dbg !7
+  call void @use(ptr %p), !dbg !7
+  call void @llvm.stackrestore.p0(ptr %sp), !dbg !7
+  ret void, !dbg !7
+}
+
+!llvm.dbg.cu = !{!0}
+!llvm.module.flags = !{!2, !3}
+
+!0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, emissionKind: FullDebug)
+!1 = !DIFile(filename: "t.c", directory: "/tmp")
+!2 = !{i32 7, !"Dwarf Version", i32 4}
+!3 = !{i32 2, !"Debug Info Version", i32 3}
+!4 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)
+!5 = !DISubroutineType(types: !6)
+!6 = !{null}
+!7 = !DILocation(line: 1, scope: !4)
diff --git a/llvm/test/CodeGen/SystemZ/zos-stackrestore.ll b/llvm/test/CodeGen/SystemZ/zos-stackrestore.ll
index cb33fbbdcc..8080cc43c0 100755
--- a/llvm/test/CodeGen/SystemZ/zos-stackrestore.ll
+++ b/llvm/test/CodeGen/SystemZ/zos-stackrestore.ll
@@ -4,27 +4,11 @@
 ; @@ALCAXP moves the frame header (save area at SP + 2048) down with the stack
 ; pointer. A stack restore must copy the current header to the restored stack
 ; pointer, and no signal may be delivered meanwhile. This is done in a stub
-; routine (stub entry marker, no PPA1), which is emitted once per module at the
-; start of the code section and gets the new stack pointer in R1.
+; routine (stub entry marker, no PPA1), which is emitted once per module after
+; the last function and gets the new stack pointer in R1.
 
 declare void @use(ptr)
 
-; The stub copies the header in blocks of 32 bytes from the highest block down
-; and sets R4. It is called with BASR 3,3 and returns with B 2(3).
-; CHECK:      * XPLINK Stub Entry Padding
-; CHECK-NEXT:  DC XL8'0000000000000000'
-; CHECK-NEXT: * XPLINK Stub Entry Marker
-; CHECK-NEXT: * Eyecatcher 0x00C300C500C500
-; CHECK-NEXT:  DC XL7'00C300C500C500'
-; CHECK-NEXT: * Mark Type C'4'
-; CHECK-NEXT:  DC XL1'F4'
-; CHECK-NEXT: [[STUB:L#stackrestore[0-9]+]] DS 0H
-; CHECK-NEXT:  mvc 2144(32,1),2144(4)
-; CHECK-NEXT:  mvc 2112(32,1),2112(4)
-; CHECK-NEXT:  mvc 2080(32,1),2080(4)
-; CHECK-NEXT:  mvc 2048(32,1),2048(4)
-; CHECK-NEXT:  lgr 4,1
-; CHECK-NEXT:  b 2(3)
 ; CHECK-NOT:  Stub Entry Marker
 
 ; The stack restore calls the stub with the saved stack pointer in R1.
@@ -35,7 +19,7 @@ declare void @use(ptr)
 ; CHECK:       la 1,2240(4)
 ; CHECK:       basr 7,6
 ; CHECK:       lgr 1,[[SP]]
-; CHECK-NEXT:  larl 3,[[STUB]]
+; CHECK-NEXT:  larl 3,[[STUB:L#stackrestore[0-9]+]]
 ; CHECK-NEXT:  basr 3,3
 ; CHECK-NEXT:  bcr 0,7
 ; CHECK:       basr 7,6
@@ -59,3 +43,21 @@ define void @g(i64 %n) {
   call void @llvm.stackrestore.p0(ptr %sp)
   ret void
 }
+
+; The stub copies the header in blocks of 32 bytes from the highest block down
+; and sets R4. It is called with BASR 3,3 and returns with B 2(3).
+; CHECK:      * XPLINK Stub Entry Padding
+; CHECK-NEXT:  DC XL8'0000000000000000'
+; CHECK-NEXT: * XPLINK Stub Entry Marker
+; CHECK-NEXT: * Eyecatcher 0x00C300C500C500
+; CHECK-NEXT:  DC XL7'00C300C500C500'
+; CHECK-NEXT: * Mark Type C'4'
+; CHECK-NEXT:  DC XL1'F4'
+; CHECK-NEXT: [[STUB]] DS 0H
+; CHECK-NEXT:  mvc 2144(32,1),2144(4)
+; CHECK-NEXT:  mvc 2112(32,1),2112(4)
+; CHECK-NEXT:  mvc 2080(32,1),2080(4)
+; CHECK-NEXT:  mvc 2048(32,1),2048(4)
+; CHECK-NEXT:  lgr 4,1
+; CHECK-NEXT:  b 2(3)
+; CHECK-NOT:  Stub Entry Marker
-- 
