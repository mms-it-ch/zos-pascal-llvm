From 7b4e2609a905ba0f8e16168ef3d1ed4b03c4a976 Mon Sep 17 00:00:00 2001
From: mms-it-ch <info@mms-it.ch>
Date: Sun, 27 Sep 2026 14:03:24 +0200
Subject: [PATCH 6/9] [SystemZ][z/OS] Emit one byte for globals of size zero

In GOFF, a part (PR) of length zero is a reference, not a definition, so
a global of size zero (e.g. an empty record) could not be resolved by
the binder (IEW2456E ... UNRESOLVED). Emit a single zero byte as is done
for targets with subsections via symbols.

Found with Free Pascal, which uses empty records as start/end markers.

Assisted-by: Claude Code (Anthropic)
---
 llvm/lib/CodeGen/AsmPrinter/AsmPrinter.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/llvm/lib/CodeGen/AsmPrinter/AsmPrinter.cpp b/llvm/lib/CodeGen/AsmPrinter/AsmPrinter.cpp
index f3ac25f25..f0a3200e3 100644
--- a/llvm/lib/CodeGen/AsmPrinter/AsmPrinter.cpp
+++ b/llvm/lib/CodeGen/AsmPrinter/AsmPrinter.cpp
@@ -4583,9 +4583,11 @@ void AsmPrinter::emitGlobalConstant(const DataLayout &DL, const Constant *CV,
   uint64_t Size = DL.getTypeAllocSize(CV->getType());
   if (Size)
     emitGlobalConstantImpl(DL, CV, *this, nullptr, 0, AliasList);
-  else if (MAI.hasSubsectionsViaSymbols()) {
+  else if (MAI.hasSubsectionsViaSymbols() ||
+           TM.getTargetTriple().isOSBinFormatGOFF()) {
     // If the global has zero size, emit a single byte so that two labels don't
-    // look like they are at the same location.
+    // look like they are at the same location. In GOFF, a part (PR) of length
+    // zero is a reference, not a definition.
     OutStreamer->emitIntValue(0, 1);
   }
   if (!AliasList)
