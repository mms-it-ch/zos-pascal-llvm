{
  "comments": {
    "lineComment": "//",
    "blockComment": ["{", "}"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "{", "close": "}", "notIn": ["string"] },
    { "open": "(*", "close": "*)", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["'", "'"],
    ["{", "}"]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "(?i)^\\s*(begin|repeat|try|record|case\\b.*\\bof|class\\b(?!\\s*;)|object|interface\\s*$|asm|except|finally|else\\s*$|then\\s*$|do\\s*$|var\\s*$|const\\s*$|type\\s*$)\\b.*$",
    "decreaseIndentPattern": "(?i)^\\s*(end|until|except|finally)\\b"
  },
  "folding": {
    "markers": {
      "start": "(?i)^\\s*(\\{\\$region\\b|begin\\b|repeat\\b|try\\b|asm\\b|case\\b.*\\bof\\b|.*\\b(record|class|object|interface)\\b\\s*(\\(.*\\))?\\s*$)",
      "end": "(?i)^\\s*(\\{\\$endregion\\b|end\\b|until\\b)"
    }
  }
}
