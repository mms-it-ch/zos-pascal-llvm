#!/bin/sh
# zos-irc: "clang"-Ersatz für FPC (Target zos): LLVM-IR -> GOFF mit llc.
#
# FPC ruft den LLVM-Assembler auf als
#   clang -x ir <Optionen> -target <triple> -c -o <obj> <datei.ll> [...]
# Das Skript übernimmt -O<n>, -o und die Eingabedatei und ruft
#   [opt -O<n> |] llc -O<n> -mtriple=s390x-ibm-zos -filetype=obj
# Grund: für den Pascal-Weg wird nur llc aus dem eigenen LLVM-Build gebraucht
# (~/build/llvm-pascal, mit den z/OS-Korrekturen); ein opt daneben wird für
# die IR-Optimierung benutzt, falls vorhanden.
# Umgebung: ZOS_LLVM_BIN (Standard ~/build/llvm-pascal/bin).
BIN=${ZOS_LLVM_BIN:-$HOME/build/llvm-pascal/bin}
OLEVEL=0; OUT=""; IN=""
while [ $# -gt 0 ]; do
  case "$1" in
    -O0|-O1|-O2|-O3) OLEVEL=${1#-O} ;;
    -o) OUT=$2; shift ;;
    -x|-target) shift ;;
    *.ll|*.bc) IN=$1 ;;
  esac
  shift
done
[ -n "$IN" ] && [ -n "$OUT" ] || { echo "zos-irc: Eingabe oder -o fehlt" >&2; exit 2; }

# z/OS-Debugger (VS-Code-Erweiterung): ZOS_ZDBG=1 und -g -> Zeilen-Haken und Frame-Sätze
# einfügen (scripts/zdbg-instrument.py; Agent runtime/zosdbg.c im RTL-Archiv)
if [ "$ZOS_ZDBG" = 1 ] && grep -q '^!llvm.dbg.cu' "$IN" 2>/dev/null; then
  ZI="${OUT%.o}.zdbg.ll"
  python3 "$(dirname "$(readlink -f "$0")")/zdbg-instrument.py" "$IN" > "$ZI" || exit 1
  IN=$ZI
  trap 'rm -f "$ZI"' EXIT
fi

# Debug-Informationen (-g, -gl): die DWARF-Klassen, die LLVM ins GOFF schreibt, weist
# der z/OS-Binder zurück (IEW2353E 250001). Deshalb zwei Objekte: <out> ohne
# Debug-Informationen (wird gebunden) und <out ohne .o>.dbgo mit ihnen, aus dem
# zos-ld (goff-lines.py) die Zeilentabelle für Backtraces liest. Debug-Informationen
# ändern den Code nicht; goff-lines.py vergleicht den Code beider Objekte.
if grep -q '^!llvm.dbg.cu' "$IN" 2>/dev/null; then
  DBGO="${OUT%.o}.dbgo"
  if [ "$OLEVEL" != 0 ] && [ -x "$BIN/opt" ]; then
    "$BIN/opt" -O"$OLEVEL" "$IN" | "$BIN/llc" -O"$OLEVEL" -mtriple=s390x-ibm-zos -filetype=obj -o "$DBGO" &&
    "$BIN/opt" -strip-debug "$IN" | "$BIN/opt" -O"$OLEVEL" |       "$BIN/llc" -O"$OLEVEL" -mtriple=s390x-ibm-zos -filetype=obj -o "$OUT"
  else
    "$BIN/llc" -O"$OLEVEL" -mtriple=s390x-ibm-zos -filetype=obj -o "$DBGO" "$IN" &&
    "$BIN/opt" -strip-debug "$IN" | "$BIN/llc" -O"$OLEVEL" -mtriple=s390x-ibm-zos -filetype=obj -o "$OUT"
  fi
  exit $?
fi
if [ "$OLEVEL" != 0 ] && [ -x "$BIN/opt" ]; then
  "$BIN/opt" -O"$OLEVEL" "$IN" | "$BIN/llc" -O"$OLEVEL" -mtriple=s390x-ibm-zos -filetype=obj -o "$OUT"
else
  exec "$BIN/llc" -O"$OLEVEL" -mtriple=s390x-ibm-zos -filetype=obj -o "$OUT" "$IN"
fi
