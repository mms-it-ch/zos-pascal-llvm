#!/bin/sh
# zos-put: eine lokale Datei (WSL-Pfad) unverändert (binär) nach z/OS kopieren.
#   zos-put <datei> <ziel auf z/OS>
# Läuft in WSL; sftp.exe von Git für Windows liest die Datei über ihren Windows-Pfad,
# deshalb geht sie über das Windows-Temp (unter Linux direkt, zos-hostenv.sh).
# Zugangsdaten aus .zos.env.
SELF=$(readlink -f "$0")
. "$(dirname "$SELF")/zos-hostenv.sh"
ENVFILE=${ZOS_ENV:-$(dirname "$SELF")/../.zos.env}
WH=$(zos_winhome)
HOME=$WH . "$ENVFILE"
[ $# -eq 2 ] || { echo "usage: zos-put <datei> <ziel>" >&2; exit 2; }
SRCF=$1
case "$ZOS_HOSTENV:$SRCF" in
  linux:*|wsl:/mnt/*) ;;
  *)
    WTMP=$(zos_wintemp)
    T=$WTMP/zos-put.$$
    cp "$SRCF" "$T" || exit 1
    trap 'rm -f "$T"' EXIT
    SRCF=$T ;;
esac
echo "put $(zos_winpath "$SRCF") $2" | $ZOS_SFTP -q -i "$ZOS_KEY" -o BatchMode=yes -b - "$ZOS_HOST" >/dev/null
